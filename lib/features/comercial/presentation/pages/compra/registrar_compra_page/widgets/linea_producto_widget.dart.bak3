import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:fiscogest_rd/features/comercial/presentation/pages/compra/registrar_compra_page/widgets/tipos_linea.dart';
import 'package:fiscogest_rd/core/ui/ui.dart';
import 'package:fiscogest_rd/features/impuestos/domain/services/resolver_tasa_itbis.dart';

class LineaProductoWidget extends StatelessWidget {
  const LineaProductoWidget({
    super.key,
    required this.index,
    required this.linea,
    required this.ctrl,
    required this.onEliminar,
    required this.onSeleccionarProducto,
    required this.onCantidadChanged,
    required this.onCostoChanged,
    required this.onFleteChanged,
    required this.onSeguroChanged,
    required this.onArancelesChanged,
    required this.onGastosChanged,
    required this.onDescuentoChanged,
    required this.esPequena,
    required this.filaResponsiva,
    this.modoSimplificado = false,
  });

  final int index;
  final DetalleLinea linea;
  final ControladoresLinea ctrl;
  final VoidCallback onEliminar;
  final VoidCallback onSeleccionarProducto;
  final ValueChanged<String> onCantidadChanged;
  final ValueChanged<String> onCostoChanged;
  final ValueChanged<String> onFleteChanged;
  final ValueChanged<String> onSeguroChanged;
  final ValueChanged<String> onArancelesChanged;
  final ValueChanged<String> onGastosChanged;
  final ValueChanged<String> onDescuentoChanged;
  final bool esPequena;
  final Widget Function({required Widget child1, required Widget child2})
      filaResponsiva;
  final bool modoSimplificado;

  @override
  Widget build(BuildContext context) {
    final desktop = AppBreakpoints.isDesktop(context);
    if (desktop) return _buildDesktopRow(context);
    return _buildMobileCard(context);
  }

  Widget _buildDesktopRow(BuildContext context) {
    final nombre = ctrl.nombreProducto.text.trim().isEmpty
        ? 'Seleccionar producto…'
        : ctrl.nombreProducto.text.trim();
    final tieneProducto = ctrl.nombreProducto.text.trim().isNotEmpty;

    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 12),
      decoration: const BoxDecoration(
        border: Border(
          bottom: BorderSide(color: Color(0xFFEDF2F7)),
        ),
      ),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.center,
        children: [
          // Producto
          Expanded(
            flex: 4,
            child: InkWell(
              onTap: onSeleccionarProducto,
              borderRadius: BorderRadius.circular(8),
              child: Row(
                children: [
                  Container(
                    width: 40,
                    height: 40,
                    decoration: BoxDecoration(
                      color: const Color(0xFFE2E8F0),
                      borderRadius: BorderRadius.circular(6),
                    ),
                    child: Icon(
                      tieneProducto
                          ? Icons.inventory_2_outlined
                          : Icons.search,
                      size: 20,
                      color: const Color(0xFFA0AEC0),
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Text(
                      nombre,
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                      style: TextStyle(
                        fontSize: 13,
                        fontWeight:
                            tieneProducto ? FontWeight.w600 : FontWeight.w400,
                        color: tieneProducto
                            ? const Color(0xFF1A202C)
                            : const Color(0xFFA0AEC0),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
          // Cantidad
          Expanded(
            flex: 2,
            child: SizedBox(
              height: 36,
              child: TextField(
                controller: ctrl.cantidad,
                keyboardType:
                    const TextInputType.numberWithOptions(decimal: true),
                inputFormatters: [
                  FilteringTextInputFormatter.allow(RegExp(r'^\d+\.?\d{0,4}')),
                ],
                onChanged: onCantidadChanged,
                textAlign: TextAlign.center,
                style: const TextStyle(
                  fontWeight: FontWeight.w600,
                  fontSize: 13,
                ),
                decoration: InputDecoration(
                  contentPadding:
                      const EdgeInsets.symmetric(horizontal: 8, vertical: 8),
                  border: OutlineInputBorder(
                    borderRadius: BorderRadius.circular(6),
                    borderSide: BorderSide(color: AppColors.border),
                  ),
                  enabledBorder: OutlineInputBorder(
                    borderRadius: BorderRadius.circular(6),
                    borderSide: BorderSide(color: AppColors.border),
                  ),
                  focusedBorder: OutlineInputBorder(
                    borderRadius: BorderRadius.circular(6),
                    borderSide: const BorderSide(color: AppColors.primary),
                  ),
                  isDense: true,
                ),
              ),
            ),
          ),
          // Precio unitario
          Expanded(
            flex: 2,
            child: Padding(
              padding: const EdgeInsets.symmetric(horizontal: 6),
              child: SizedBox(
                height: 36,
                child: TextField(
                  controller: ctrl.costoUnitario,
                  keyboardType:
                      const TextInputType.numberWithOptions(decimal: true),
                  inputFormatters: [
                    FilteringTextInputFormatter.allow(
                        RegExp(r'^\d+\.?\d{0,2}')),
                  ],
                  onChanged: onCostoChanged,
                  style: const TextStyle(fontSize: 13),
                  decoration: InputDecoration(
                    prefixText: 'RD\$ ',
                    contentPadding:
                        const EdgeInsets.symmetric(horizontal: 8, vertical: 8),
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(6),
                      borderSide: BorderSide(color: AppColors.border),
                    ),
                    enabledBorder: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(6),
                      borderSide: BorderSide(color: AppColors.border),
                    ),
                    focusedBorder: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(6),
                      borderSide: const BorderSide(color: AppColors.primary),
                    ),
                    isDense: true,
                  ),
                ),
              ),
            ),
          ),
          // ITBIS
          Expanded(
            flex: 2,
            child: Text(
              modoSimplificado
                  ? '—'
                  : formatRdNumero(linea.itbisLinea),
              style: const TextStyle(fontSize: 13, color: Color(0xFF4A5568)),
            ),
          ),
          // Total
          Expanded(
            flex: 2,
            child: Text(
              formatRdNumero(linea.totalLinea),
              style: const TextStyle(
                fontSize: 13,
                fontWeight: FontWeight.w700,
                color: Color(0xFF1A202C),
              ),
            ),
          ),
          // Eliminar
          SizedBox(
            width: 40,
            child: IconButton(
              icon: const Icon(Icons.delete_outline, color: Color(0xFFE53E3E), size: 20),
              onPressed: onEliminar,
              tooltip: 'Eliminar línea',
              padding: EdgeInsets.zero,
              constraints: const BoxConstraints(minWidth: 32, minHeight: 32),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildMobileCard(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.only(bottom: AppSpacing.m),
      child: AppCard(
        borderColor: AppColors.border,
        padding: AppSpacing.allM,
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text('Línea ${index + 1}', style: AppTypography.labelMedium),
                IconButton(
                  icon: const Icon(
                    Icons.delete_outline,
                    color: AppColors.error,
                    size: 20,
                  ),
                  onPressed: onEliminar,
                  padding: EdgeInsets.zero,
                  constraints: const BoxConstraints(
                    minWidth: 28,
                    minHeight: 28,
                  ),
                ),
              ],
            ),
            AppLayout.vXs,
            filaResponsiva(
              child1: AppTextField(
                controller: ctrl.productoId,
                label: 'ID',
                keyboardType: TextInputType.number,
                onChanged: onCantidadChanged,
              ),
              child2: GestureDetector(
                onTap: onSeleccionarProducto,
                child: AbsorbPointer(
                  child: AppTextField(
                    controller: ctrl.nombreProducto,
                    label: 'Seleccionar Producto',
                    prefixIcon: Icons.search,
                  ),
                ),
              ),
            ),
            AppLayout.vS,
            const Text('Costos', style: AppTypography.labelMedium),
            AppLayout.vXs,
            filaResponsiva(
              child1: AppTextField(
                controller: ctrl.cantidad,
                label: 'Cantidad',
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                inputFormatters: [
                  FilteringTextInputFormatter.allow(RegExp(r'^\d+\.?\d{0,4}')),
                ],
                onChanged: onCantidadChanged,
              ),
              child2: AppTextField(
                controller: ctrl.costoUnitario,
                label: 'Costo Compra (RD\$)',
                prefixIcon: Icons.payments_outlined,
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                inputFormatters: [
                  FilteringTextInputFormatter.allow(RegExp(r'^\d+\.?\d{0,2}')),
                ],
                onChanged: onCostoChanged,
              ),
            ),
            AppLayout.vS,
            filaResponsiva(
              child1: AppTextField(
                controller: ctrl.fleteUnitario,
                label: 'Flete por unidad',
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                inputFormatters: [
                  FilteringTextInputFormatter.allow(RegExp(r'^\d+\.?\d{0,2}')),
                ],
                onChanged: onFleteChanged,
              ),
              child2: AppTextField(
                controller: ctrl.seguroUnitario,
                label: 'Seguro por unidad',
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                inputFormatters: [
                  FilteringTextInputFormatter.allow(RegExp(r'^\d+\.?\d{0,2}')),
                ],
                onChanged: onSeguroChanged,
              ),
            ),
            AppLayout.vS,
            filaResponsiva(
              child1: AppTextField(
                controller: ctrl.arancelesUnitario,
                label: 'Aranceles por unidad',
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                inputFormatters: [
                  FilteringTextInputFormatter.allow(RegExp(r'^\d+\.?\d{0,2}')),
                ],
                onChanged: onArancelesChanged,
              ),
              child2: AppTextField(
                controller: ctrl.gastosUnitario,
                label: 'Otros Gastos por unidad',
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                inputFormatters: [
                  FilteringTextInputFormatter.allow(RegExp(r'^\d+\.?\d{0,2}')),
                ],
                onChanged: onGastosChanged,
              ),
            ),
            AppLayout.vS,
            AppTextField(
              controller: ctrl.descuento,
              label: 'Descuento (%)',
              keyboardType: const TextInputType.numberWithOptions(
                decimal: true,
              ),
              inputFormatters: [
                FilteringTextInputFormatter.allow(RegExp(r'^\d+\.?\d{0,2}')),
              ],
              onChanged: onDescuentoChanged,
            ),
            AppLayout.vM,
            Align(
              alignment: Alignment.centerRight,
              child: ConstrainedBox(
                constraints: const BoxConstraints(maxWidth: 240),
                child: Container(
                  width: double.infinity,
                  padding: const EdgeInsets.symmetric(
                    horizontal: 12,
                    vertical: 10,
                  ),
                  decoration: BoxDecoration(
                    color: AppColors.primaryContainer.withValues(alpha: 0.35),
                    borderRadius: AppRadius.allM,
                    border: Border.all(color: AppColors.border),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.end,
                    children: [
                      Text(
                        'Subtotal: ${formatRdNumero(linea.subtotalLinea)}',
                        style: AppTypography.bodySmall.copyWith(
                          color: AppColors.textSecondary,
                        ),
                      ),
                      if (!modoSimplificado)
                        Text(
                          '${etiquetaItbisLineas([linea.tasaImpuestoLinea])}: ${formatRdNumero(linea.itbisLinea)}',
                          style: AppTypography.bodySmall.copyWith(
                            color: AppColors.textSecondary,
                          ),
                        ),
                      const Divider(height: 12, color: AppColors.border),
                      Text(
                        'Total línea: ${formatRdNumero(linea.totalLinea)}',
                        style: AppTypography.labelLarge.copyWith(
                          color: AppColors.primary,
                          fontWeight: FontWeight.w700,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
