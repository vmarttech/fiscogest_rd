import 'package:flutter/material.dart';
import 'package:fiscogest_rd/core/ui/ui.dart';

class CabeceraCompraWidget extends StatelessWidget {
  const CabeceraCompraWidget({
    super.key,
    required this.fechaController,
    required this.proveedorIdController,
    required this.proveedorNombreController,
    required this.onSeleccionarProveedor,
    required this.comprobanteController,
    required this.ncfController,
    required this.tipoComprobante,
    required this.onTipoComprobanteChanged,
    required this.formaPago,
    required this.onFormaPagoChanged,
    required this.condicionPagoController,
    required this.diasCreditoController,
    required this.fechaVencimientoController,
    required this.observacionesController,
    required this.esPequena,
    required this.filaResponsiva,
    this.modoSimplificado = false,
  });
  final TextEditingController fechaController;
  final TextEditingController proveedorIdController;
  final TextEditingController proveedorNombreController;
  final VoidCallback onSeleccionarProveedor;
  final TextEditingController comprobanteController;
  final TextEditingController ncfController;
  final String tipoComprobante;
  final ValueChanged<String> onTipoComprobanteChanged;
  final String formaPago;
  final ValueChanged<String> onFormaPagoChanged;
  final TextEditingController condicionPagoController;
  final TextEditingController diasCreditoController;
  final TextEditingController fechaVencimientoController;
  final TextEditingController observacionesController;
  final bool esPequena;
  final bool modoSimplificado;
  final Widget Function({required Widget child1, required Widget child2})
  filaResponsiva;

  Widget _buildChipTipoComprobante(
    String valor,
    String etiqueta,
    BuildContext context,
  ) {
    final seleccionado = tipoComprobante == valor;
    return InkWell(
      onTap: () => onTipoComprobanteChanged(valor),
      borderRadius: AppRadius.allM,
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
        decoration: BoxDecoration(
          color: seleccionado
              ? AppColors.primary.withValues(alpha: 0.15)
              : AppColors.grey50,
          borderRadius: AppRadius.allM,
          border: Border.all(
            color: seleccionado
                ? AppColors.primary
                : AppColors.border,
          ),
        ),
        child: Text(
          '$valor • $etiqueta',
          style: AppTypography.bodySmall.copyWith(
            color: seleccionado ? AppColors.primary : null,
            fontWeight: seleccionado ? FontWeight.w500 : null,
          ),
        ),
      ),
    );
  }

  Widget _buildBotonFormaPago(
    String valor,
    String etiqueta,
    BuildContext context,
  ) {
    final seleccionado = formaPago == valor;
    return Expanded(
      child: InkWell(
        onTap: () => onFormaPagoChanged(valor),
        borderRadius: BorderRadius.circular(6),
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 150),
          padding: const EdgeInsets.symmetric(vertical: 8),
          decoration: BoxDecoration(
            color: seleccionado ? Colors.white : Colors.transparent,
            borderRadius: BorderRadius.circular(6),
            boxShadow: seleccionado
                ? [
                    BoxShadow(
                      color: Colors.black.withValues(alpha: 0.05),
                      blurRadius: 4,
                      offset: const Offset(0, 2),
                    ),
                  ]
                : null,
          ),
          alignment: Alignment.center,
          child: Text(
            etiqueta,
            style: AppTypography.bodySmall.copyWith(
              color: seleccionado ? AppColors.primary : AppColors.textSecondary,
              fontWeight: FontWeight.w600,
              fontSize: 13,
            ),
          ),
        ),
      ),
    );
  }

  Widget _tituloSeccion(String titulo) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 16),
      child: Container(
        width: double.infinity,
        padding: const EdgeInsets.only(bottom: 8),
        decoration: const BoxDecoration(
          border: Border(
            bottom: BorderSide(color: Color(0xFFF0F4F8), width: 2),
          ),
        ),
        child: Text(
          titulo,
          style: const TextStyle(
            fontSize: 12,
            fontWeight: FontWeight.w700,
            letterSpacing: 0.5,
            color: Color(0xFF2D3748),
          ),
        ),
      ),
    );
  }

  Widget _segmentedPago(BuildContext context) {
    final ops = <(String, String)>[
      ('contado', 'Contado'),
      if (!modoSimplificado) ('credito', 'Crédito'),
      if (!modoSimplificado) ('transferencia', 'Transferencia'),
    ];
    return Container(
      padding: const EdgeInsets.all(4),
      decoration: BoxDecoration(
        color: const Color(0xFFF1F5F9),
        borderRadius: BorderRadius.circular(10),
        border: Border.all(color: AppColors.border),
      ),
      child: Row(
        children: [
          for (final o in ops) _buildBotonFormaPago(o.$1, o.$2, context),
        ],
      ),
    );
  }

  Widget _cardDatosGenerales(BuildContext context) {
    return AppCard(
      borderColor: AppColors.border,
      padding: const EdgeInsets.all(24),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _tituloSeccion('DATOS GENERALES'),
          filaResponsiva(
            child1: AppTextField(
              controller: fechaController,
              label: 'Fecha de compra',
              enabled: false,
              prefixIcon: Icons.calendar_today_outlined,
            ),
            child2: AppTextField(
              controller: proveedorIdController,
              label: 'ID Proveedor',
              prefixIcon: Icons.badge_outlined,
            ),
          ),
          AppLayout.vM,
          GestureDetector(
            onTap: onSeleccionarProveedor,
            child: AbsorbPointer(
              child: AppTextField(
                controller: proveedorNombreController,
                label: 'Proveedor / Sucursal',
                prefixIcon: Icons.store_outlined,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _cardDetalles(BuildContext context) {
    return AppCard(
      borderColor: AppColors.border,
      padding: const EdgeInsets.all(24),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _tituloSeccion('DETALLES DE COMPROBANTE Y PAGO'),
          if (modoSimplificado)
            AppTextField(
              controller: comprobanteController,
              label: 'Nº factura / recibo (opcional)',
              prefixIcon: Icons.receipt_outlined,
            )
          else
            filaResponsiva(
              child1: AppTextField(
                controller: comprobanteController,
                label: 'Comprobante / Nº Factura',
                prefixIcon: Icons.receipt_outlined,
              ),
              child2: AppTextField(
                controller: ncfController,
                label: 'NCF (ej: B01-00000000)',
                prefixIcon: Icons.gavel_outlined,
              ),
            ),
          if (!modoSimplificado) ...[
            AppLayout.vM,
            const Text('Tipo de Comprobante', style: AppTypography.labelMedium),
            AppLayout.vS,
            Wrap(
              spacing: 8,
              runSpacing: 8,
              children: [
                _buildChipTipoComprobante('B01', 'Gastos', context),
                _buildChipTipoComprobante('B02', 'Activos', context),
                _buildChipTipoComprobante('B14', 'Gastos Menores', context),
                _buildChipTipoComprobante('B15', 'Exento', context),
              ],
            ),
          ],
          AppLayout.vM,
          const Text('Forma de Pago', style: AppTypography.labelMedium),
          AppLayout.vS,
          _segmentedPago(context),
          if (!modoSimplificado && formaPago == 'credito') ...[
            AppLayout.vM,
            filaResponsiva(
              child1: AppTextField(
                controller: condicionPagoController,
                label: 'Condición de Pago (ej: 30 días)',
              ),
              child2: AppTextField(
                controller: diasCreditoController,
                label: 'Días de Crédito',
                keyboardType: TextInputType.number,
              ),
            ),
            AppLayout.vM,
            AppTextField(
              controller: fechaVencimientoController,
              label: 'Fecha de Vencimiento (YYYY-MM-DD)',
              prefixIcon: Icons.event_outlined,
            ),
          ],
        ],
      ),
    );
  }

  /// Layout móvil original (una sola card).
  Widget _buildMobile(BuildContext context) {
    return AppCard(
      borderColor: AppColors.border,
      padding: AppSpacing.allM,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          AppTextField(
            controller: fechaController,
            label: 'Fecha de compra',
            enabled: false,
            prefixIcon: Icons.calendar_today_outlined,
          ),
          AppLayout.vM,
          filaResponsiva(
            child1: AppTextField(
              controller: proveedorIdController,
              label: 'ID Proveedor',
            ),
            child2: GestureDetector(
              onTap: onSeleccionarProveedor,
              child: AbsorbPointer(
                child: AppTextField(
                  controller: proveedorNombreController,
                  label: 'Proveedor',
                  prefixIcon: Icons.search,
                ),
              ),
            ),
          ),
          AppLayout.vM,
          if (modoSimplificado)
            AppTextField(
              controller: comprobanteController,
              label: 'Nº factura / recibo (opcional)',
              prefixIcon: Icons.receipt_outlined,
            )
          else
            filaResponsiva(
              child1: AppTextField(
                controller: comprobanteController,
                label: 'Comprobante / Nº Factura',
                prefixIcon: Icons.receipt_outlined,
              ),
              child2: AppTextField(
                controller: ncfController,
                label: 'NCF (ej: B01-00000000)',
                prefixIcon: Icons.confirmation_num_outlined,
              ),
            ),
          AppLayout.vM,
          if (!modoSimplificado) ...[
            const Text('Tipo de Comprobante', style: AppTypography.labelMedium),
            AppLayout.vS,
            Wrap(
              spacing: AppSpacing.s,
              runSpacing: AppSpacing.s,
              children: [
                _buildChipTipoComprobante('B01', 'Gastos', context),
                _buildChipTipoComprobante('B02', 'Activos', context),
                _buildChipTipoComprobante('B14', 'Gastos Menores', context),
                _buildChipTipoComprobante('B15', 'Exento', context),
              ],
            ),
            AppLayout.vM,
          ],
          const Text('Forma de Pago', style: AppTypography.labelMedium),
          AppLayout.vS,
          _segmentedPago(context),
          AppLayout.vM,
          if (!modoSimplificado && formaPago == 'credito') ...[
            filaResponsiva(
              child1: AppTextField(
                controller: condicionPagoController,
                label: 'Condición de Pago (ej: 30 días)',
              ),
              child2: AppTextField(
                controller: diasCreditoController,
                label: 'Días de Crédito',
                keyboardType: TextInputType.number,
              ),
            ),
            AppLayout.vM,
            AppTextField(
              controller: fechaVencimientoController,
              label: 'Fecha de Vencimiento (YYYY-MM-DD)',
              prefixIcon: Icons.event_outlined,
            ),
            AppLayout.vM,
          ],
          AppTextField(
            controller: observacionesController,
            label: 'Observaciones',
            prefixIcon: Icons.notes_outlined,
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final desktop = AppBreakpoints.isDesktop(context);
    if (!desktop) return _buildMobile(context);

    // PC: dos tarjetas + observaciones van al resumen (se dejan aquí si no hay slot)
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _cardDatosGenerales(context),
        const SizedBox(height: 20),
        _cardDetalles(context),
      ],
    );
  }
}
