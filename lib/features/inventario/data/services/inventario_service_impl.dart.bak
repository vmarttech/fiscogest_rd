import 'package:fiscogest_rd/core/database/app_database.dart';
import 'package:fiscogest_rd/features/inventario/domain/services/i_inventario_service.dart';

class InventarioServiceImpl implements IInventarioService {
  InventarioServiceImpl(this.db);
  final AppDatabase db;

  @override
  Future<void> sumarStock(int productoId, double cantidad) async {
    if(cantidad <= 0) throw Exception('Cantidad debe ser mayor a cero');

    final producto = await (db.select(db.productosTable)
      ..where((p) => p.id.equals(productoId))).getSingle();

    await db.update(db.productosTable).replace(
      producto.copyWith(stock: producto.stock + cantidad),
    );
  }

  @override
  Future<void> restarStock(int productoId, double cantidad) async {
    if(cantidad <= 0) throw Exception('Cantidad debe ser mayor a cero');

    final producto = await (db.select(db.productosTable)
      ..where((p) => p.id.equals(productoId))).getSingle();

    if(producto.stock < cantidad){
      throw Exception('Stock insuficiente. Disponible: ${producto.stock}');
    }

    await db.update(db.productosTable).replace(
      producto.copyWith(stock: producto.stock - cantidad),
    );
  }

  @override
  Future<double> obtenerStockActual(int productoId) async {
    final producto = await (db.select(db.productosTable)
      ..where((p) => p.id.equals(productoId))).getSingle();
    return producto.stock;
  }

  @override
  Future<bool> esStockSuficiente(int productoId, double cantidad) async{
    final prod = await (db.select(db.productosTable)
      ..where((p)=>p.id.equals(productoId))).getSingle();
    return prod.stock >= cantidad;
  }

  @override
  Future<(double min, double max)> obtenerLimitesStock(int productoId) async{
    final prod = await (db.select(db.productosTable)
      ..where((p)=>p.id.equals(productoId))).getSingle();
    // ✅ CORREGIDO: sin campo stockMaximo → valor seguro por defecto
    final minimo = prod.stockMinimo ?? 0.0;
    const maximo = 999999.0;
    return (minimo, maximo);
  }

  @override
  Future<List<int>> obtenerProductosBajosDeStock() async{
    final registros = await db.select(db.productosTable).get();
    return registros
      .where((p)=>p.stock <= (p.stockMinimo ?? 0.0) && p.stock > 0)
      .map((p)=>p.id!).toList();
  }

  @override
  Future<List<int>> obtenerProductosAgotados() async{
    final registros = await db.select(db.productosTable).get();
    return registros.where((p)=>p.stock <= 0).map((p)=>p.id!).toList();
  }
}
