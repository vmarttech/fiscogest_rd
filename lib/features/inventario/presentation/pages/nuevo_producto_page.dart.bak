import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';
import 'package:fiscogest_rd/features/inventario/domain/entities/producto.dart';
import 'package:fiscogest_rd/features/inventario/presentation/providers/producto_providers.dart';
import 'package:fiscogest_rd/features/inventario/presentation/providers/categoria_providers.dart';
import 'package:fiscogest_rd/features/inventario/presentation/providers/marca_providers.dart';
import 'package:fiscogest_rd/features/inventario/presentation/providers/unidad_medida_providers.dart';

class NuevoProductoPage extends ConsumerStatefulWidget {
  const NuevoProductoPage({super.key, this.productoId});
  final int? productoId;

  @override
  ConsumerState<NuevoProductoPage> createState() => _NuevoProductoPageState();
}

class _NuevoProductoPageState extends ConsumerState<NuevoProductoPage> {
  final _formKey = GlobalKey<FormState>();
  final _nombreCtrl = TextEditingController();
  final _skuCtrl = TextEditingController();
  final _costoCtrl = TextEditingController();
  final _ventaCtrl = TextEditingController();
  final _stockCtrl = TextEditingController(text: '0');
  final _stockMinCtrl = TextEditingController(text: '0');
  int? _catSel;
  int? _marcaSel;
  int? _unidadSel;
  bool _activo = true;
  Producto? _productoEditar;

  @override
  void initState() {
    super.initState();
    _cargarDatosSiEdita();
  }

  Future<void> _cargarDatosSiEdita() async {
    if (widget.productoId == null) return;
    final lista = ref.read(productoControllerProvider);
    lista.whenData((productos) {
      final prod = productos.firstWhere((p) => p.id == widget.productoId);
      setState(() {
        _productoEditar = prod;
        _nombreCtrl.text = prod.nombre;
        _skuCtrl.text = prod.codigo;
        _costoCtrl.text = prod.precioCompra.toString();
        _ventaCtrl.text = prod.precioVenta.toString();
        _stockCtrl.text = prod.stock.toString();
        _stockMinCtrl.text = prod.stockMinimo.toString();
        _catSel = prod.categoriaId;
        _marcaSel = prod.marcaId;
        _unidadSel = prod.unidadId;
        _activo = prod.activo;
      });
    });
  }

  @override
  void dispose() {
    _nombreCtrl.dispose();
    _skuCtrl.dispose();
    _costoCtrl.dispose();
    _ventaCtrl.dispose();
    _stockCtrl.dispose();
    _stockMinCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final cats = ref.watch(categoriaControllerProvider);
    final marcas = ref.watch(marcaControllerProvider);
    final unids = ref.watch(unidadMedidaControllerProvider);
    final esEdicion = widget.productoId != null;

    return Scaffold(
      backgroundColor: const Color(0xFFF8FAFC),
      appBar: AppBar(
        title: Text(esEdicion ? 'Editar Producto' : 'Registrar Nuevo Producto'),
        backgroundColor: const Color(0xFF1E293B),
        foregroundColor: Colors.white,
        elevation: 0,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(24),
        child: Form(
          key: _formKey,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              TextFormField(
                controller: _nombreCtrl,
                decoration: InputDecoration(
                  labelText: 'Nombre del Producto',
                  prefixIcon: const Icon(Icons.shopping_bag_outlined, color: Color(0xFF64748B)),
                  filled: true,
                  fillColor: Colors.white,
                  contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                  border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                  enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                  focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                ),
                validator: (v) => v?.trim().isEmpty ?? true ? 'Campo obligatorio' : null,
              ),
              const SizedBox(height: 16),

              TextFormField(
                controller: _skuCtrl,
                decoration: InputDecoration(
                  labelText: 'SKU / Código de Barra',
                  prefixIcon: const Icon(Icons.qr_code, color: Color(0xFF64748B)),
                  filled: true,
                  fillColor: Colors.white,
                  contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                  border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                  enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                  focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                ),
              ),
              const SizedBox(height: 16),

              cats.when(
                data: (lista) => DropdownButtonFormField<int>(
                  initialValue: _catSel,
                  decoration: InputDecoration(
                    labelText: 'Categoría',
                    prefixIcon: const Icon(Icons.category_outlined, color: Color(0xFF64748B)),
                    filled: true,
                    fillColor: Colors.white,
                    contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                    border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                    enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                    focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                  ),
                  items: lista.map((c) => DropdownMenuItem(value: c.id, child: Text(c.nombre))).toList(),
                  onChanged: (v) => setState(() => _catSel = v),
                  validator: (v) => v == null ? 'Seleccione una categoría' : null,
                ),
                loading: () => const Center(child: CircularProgressIndicator()),
                error: (e,_) => Text('Error cargando categorías: $e', style: const TextStyle(color: Colors.red)),
              ),
              const SizedBox(height: 16),

              marcas.when(
                data: (lista) => DropdownButtonFormField<int>(
                  initialValue: _marcaSel,
                  decoration: InputDecoration(
                    labelText: 'Marca',
                    prefixIcon: const Icon(Icons.branding_watermark_outlined, color: Color(0xFF64748B)),
                    filled: true,
                    fillColor: Colors.white,
                    contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                    border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                    enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                    focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                  ),
                  items: lista.map((m) => DropdownMenuItem(value: m.id, child: Text(m.nombre))).toList(),
                  onChanged: (v) => setState(() => _marcaSel = v),
                ),
                loading: () => const Center(child: CircularProgressIndicator()),
                error: (e,_) => Text('Error cargando marcas: $e', style: const TextStyle(color: Colors.red)),
              ),
              const SizedBox(height: 16),

              unids.when(
                data: (lista) => DropdownButtonFormField<int>(
                  initialValue: _unidadSel,
                  decoration: InputDecoration(
                    labelText: 'Unidad de Medida',
                    prefixIcon: const Icon(Icons.straighten_outlined, color: Color(0xFF64748B)),
                    filled: true,
                    fillColor: Colors.white,
                    contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                    border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                    enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                    focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                  ),
                  items: lista.map((u) => DropdownMenuItem(value: u.id, child: Text(u.nombre))).toList(),
                  onChanged: (v) => setState(() => _unidadSel = v),
                  validator: (v) => v == null ? 'Seleccione unidad de medida' : null,
                ),
                loading: () => const Center(child: CircularProgressIndicator()),
                error: (e,_) => Text('Error cargando unidades: $e', style: const TextStyle(color: Colors.red)),
              ),
              const SizedBox(height: 16),

              Row(
                children: [
                  Expanded(
                    child: TextFormField(
                      controller: _costoCtrl,
                      keyboardType: TextInputType.number,
                      decoration: InputDecoration(
                        labelText: 'Costo (RD\$)',
                        prefixIcon: const Icon(Icons.payments_outlined, color: Color(0xFF64748B)),
                        filled: true,
                        fillColor: Colors.white,
                        contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                        border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                        enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                        focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                      ),
                    ),
                  ),
                  const SizedBox(width: 16),
                  Expanded(
                    child: TextFormField(
                      controller: _ventaCtrl,
                      keyboardType: TextInputType.number,
                      decoration: InputDecoration(
                        labelText: 'Precio Venta (RD\$)',
                        prefixIcon: const Icon(Icons.sell_outlined, color: Color(0xFF64748B)),
                        filled: true,
                        fillColor: Colors.white,
                        contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                        border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                        enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                        focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 16),

              Row(
                children: [
                  Expanded(
                    child: TextFormField(
                      controller: _stockCtrl,
                      keyboardType: TextInputType.number,
                      decoration: InputDecoration(
                        labelText: 'Existencia Actual',
                        prefixIcon: const Icon(Icons.format_list_numbered, color: Color(0xFF64748B)),
                        filled: true,
                        fillColor: Colors.white,
                        contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                        border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                        enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                        focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                      ),
                    ),
                  ),
                  const SizedBox(width: 16),
                  Expanded(
                    child: TextFormField(
                      controller: _stockMinCtrl,
                      keyboardType: TextInputType.number,
                      decoration: InputDecoration(
                        labelText: 'Stock Mínimo (Alerta)',
                        prefixIcon: const Icon(Icons.warning_amber_rounded, color: Color(0xFF64748B)),
                        filled: true,
                        fillColor: Colors.white,
                        contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
                        border: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: BorderSide.none),
                        enabledBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFFE2E8F0), width: 1)),
                        focusedBorder: OutlineInputBorder(borderRadius: BorderRadius.circular(12), borderSide: const BorderSide(color: Color(0xFF0A2463), width: 1.5)),
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 24),

              SwitchListTile(
                title: const Text('Producto Activo para la Venta', style: TextStyle(color: Color(0xFF1E293B), fontSize: 14, fontWeight: FontWeight.w500)),
                value: _activo,
                activeThumbColor: const Color(0xFF0A2463),
                onChanged: (v) => setState(() => _activo = v),
                contentPadding: EdgeInsets.zero,
              ),
              const SizedBox(height: 32),

              SizedBox(
                width: double.infinity,
                height: 48,
                child: ElevatedButton(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF1E293B),
                    foregroundColor: Colors.white,
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                    elevation: 0,
                    textStyle: const TextStyle(fontSize: 15, fontWeight: FontWeight.w600),
                  ),
                  onPressed: () {
                    if (!_formKey.currentState!.validate()) return;
                    final stockVal = double.tryParse(_stockCtrl.text) ?? 0;
                    final stockMinVal = double.tryParse(_stockMinCtrl.text) ?? 0;
                    if (stockVal < 0 || stockMinVal < 0) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('Las cantidades no pueden ser negativas'), backgroundColor: Colors.red),
                      );
                      return;
                    }

                    // ✅ CORRECCIÓN PRINCIPAL: sin ! innecesarios, con valores seguros
                    final prodGuardar = Producto(
                      id: esEdicion ? _productoEditar?.id : null,
                      codigo: _skuCtrl.text.trim().isEmpty ? 'SKU-${DateTime.now().millisecondsSinceEpoch}' : _skuCtrl.text.trim(),
                      nombre: _nombreCtrl.text.trim(),
                      precioCompra: double.tryParse(_costoCtrl.text) ?? 0,
                      precioVenta: double.tryParse(_ventaCtrl.text) ?? 0,
                      stock: stockVal,
                      stockMinimo: stockMinVal,
                      categoriaId: _catSel ?? 0, // o valor por defecto válido
                      marcaId: _marcaSel ?? 1,
                      unidadId: _unidadSel ?? 0, // o valor por defecto válido
                      activo: _activo,
                    );

                    ref.read(productoControllerProvider.notifier).guardar(prodGuardar);
                    context.pop();
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(content: Text(esEdicion ? '¡Producto actualizado correctamente!' : '¡Producto registrado y movimiento en Kardex creado!')),
                    );
                  },
                  child: Text(esEdicion ? 'Actualizar Producto' : 'Guardar Producto'),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}