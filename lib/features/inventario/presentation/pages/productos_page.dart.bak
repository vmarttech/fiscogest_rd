import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';
import 'package:fiscogest_rd/features/inventario/presentation/providers/producto_providers.dart';
import 'package:fiscogest_rd/features/inventario/presentation/providers/kardex_provider.dart';
import 'package:fiscogest_rd/features/categorias/presentation/pages/categorias_page.dart';
import 'package:fiscogest_rd/features/marcas/presentation/pages/marcas_page.dart';
import 'package:fiscogest_rd/features/unidades/presentation/pages/unidades_page.dart';
import 'package:fiscogest_rd/features/inventario/domain/enums/tipo_movimiento.dart';
import 'package:fiscogest_rd/core/ui/app_scaffold.dart';
import 'package:fiscogest_rd/core/ui/app_spacing.dart';
import 'package:fiscogest_rd/core/ui/app_typography.dart';
import 'package:fiscogest_rd/core/ui/app_textfield.dart';
import 'package:fiscogest_rd/core/ui/app_dropdown.dart';

class ProductosPage extends ConsumerStatefulWidget {
  const ProductosPage({super.key});

  @override
  ConsumerState<ProductosPage> createState() => _ProductosPageState();
}

class _ProductosPageState extends ConsumerState<ProductosPage> with SingleTickerProviderStateMixin {
  late TabController _tabController;
  String _filtroProductos = '';
  String _filtroKardex = '';
  TipoMovimiento? _filtroTipoKardex;
  bool _busquedaActiva = false;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 5, vsync: this);
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AppScaffold(
      appBar: AppBar(
        title: FittedBox(
          fit: BoxFit.scaleDown,
          alignment: Alignment.centerLeft,
          child: Text(
            'Gestión Integral de Inventario',
            style: AppTypography.h4.copyWith(
              color: Colors.white,
              fontSize: 18.5,
            ),
            maxLines: 1,
          ),
        ),
        backgroundColor: const Color(0xFF1E293B),
        foregroundColor: Colors.white,
        elevation: 0,
        actions: [
          IconButton(
            icon: const Icon(Icons.edit_note_outlined, color: Colors.white, size: 22),
            tooltip: 'Ajustes de Inventario',
            onPressed: () => context.pushNamed('lista-ajustes'),
          ),
          const SizedBox(width: AppSpacing.s),
          _busquedaActiva
              ? SizedBox(
                  width: 180,
                  child: Row(
                    children: [
                      Expanded(
                        child: AppTextField(
                          hint: 'Buscar...',
                          onChanged: (v) => setState(() => _filtroProductos = v),
                        ),
                      ),
                      IconButton(
                        icon: const Icon(Icons.close, color: Colors.white, size: 18),
                        onPressed: () => setState(() {
                          _busquedaActiva = false;
                          _filtroProductos = '';
                        }),
                      ),
                    ],
                  ),
                )
              : IconButton(
                  icon: const Icon(Icons.search_outlined, color: Colors.white, size: 22),
                  tooltip: 'Buscar',
                  onPressed: () => setState(() => _busquedaActiva = true),
                ),
          const SizedBox(width: AppSpacing.s),
        ],
        bottom: TabBar(
          controller: _tabController,
          indicatorColor: Colors.tealAccent,
          indicatorWeight: 3,
          labelStyle: AppTypography.labelMedium.copyWith(
            fontWeight: FontWeight.bold,
            fontSize: 13,
          ),
          unselectedLabelColor: Colors.white70,
          labelColor: Colors.white,
          isScrollable: true,
          tabs: const [
            Tab(icon: Icon(Icons.inventory_2_outlined, size: 20), text: 'Productos'),
            Tab(icon: Icon(Icons.receipt_long_outlined, size: 20), text: 'Kardex'),
            Tab(icon: Icon(Icons.category_outlined, size: 20), text: 'Categorías'),
            Tab(icon: Icon(Icons.branding_watermark_outlined, size: 20), text: 'Marcas'),
            Tab(icon: Icon(Icons.straighten_outlined, size: 20), text: 'Unidades'),
          ],
        ),
      ),
      body: TabBarView(
        controller: _tabController,
        children: [
          _buildSeccionProductos(context),
          _buildSeccionKardex(context),
          const CategoriasPage(),
          const MarcasPage(),
          const UnidadesPage(),
        ],
      ),
    );
  }

  Widget _buildSeccionProductos(BuildContext context) {
    final productosAsync = ref.watch(productoControllerProvider);

    return Padding(
      padding: AppSpacing.allM,
      child: Stack(
        children: [
          Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Expanded(
                child: productosAsync.when(
                  loading: () => const Center(child: CircularProgressIndicator()),
                  error: (e, _) => Center(
                    child: Text('Error: $e', style: AppTypography.bodyMedium.copyWith(color: Colors.red)),
                  ),
                  data: (productos) {
                    final filtrados = productos
                        .where((p) => p.codigo.toLowerCase().contains(_filtroProductos) || p.nombre.toLowerCase().contains(_filtroProductos))
                        .toList();

                    if (filtrados.isEmpty) {
                      return Center(
                        child: Padding(
                          padding: AppSpacing.allL,
                          child: Text(
                            'El inventario está listo para registrar elementos.',
                            textAlign: TextAlign.center,
                            style: AppTypography.bodyMedium.copyWith(color: const Color(0xFF64748B)),
                          ),
                        ),
                      );
                    }

                    return ListView.separated(
                      padding: EdgeInsets.zero,
                      itemCount: filtrados.length,
                      separatorBuilder: (_, __) => const SizedBox(height: AppSpacing.s),
                      itemBuilder: (_, i) {
                        final prod = filtrados[i];
                        Color colorStock = const Color(0xFF1E293B);
                        final stock = prod.stock;
                        final stockMinimo = prod.stockMinimo;
                        if (stock <= 0) colorStock = const Color(0xFFDC2626);
                        else if (stock <= 5) colorStock = const Color(0xFFCA8A04);

                        // ✅ TODOS los campos protegidos: sin !, sin errores
                        final precioCompra = prod.precioCompra.toDouble();
                        final precioVenta = prod.precioVenta.toDouble();
                        final nombre = prod.nombre;
                        final codigo = prod.codigo;
                        final activo = prod.activo;
                        final productoId = prod.id ?? 0;

                        return Card(
                          elevation: 2,
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                          child: Padding(
                            padding: AppSpacing.allM,
                            child: Row(
                              children: [
                                Container(
                                  width: 50, height: 50,
                                  margin: const EdgeInsets.only(right: 16),
                                  decoration: BoxDecoration(
                                    color: const Color(0xFFF1F5F9),
                                    borderRadius: BorderRadius.circular(12),
                                  ),
                                  child: const Icon(Icons.inventory_2_outlined, color: Color(0xFF1E293B), size: 24),
                                ),
                                Expanded(
                                  child: Column(
                                    crossAxisAlignment: CrossAxisAlignment.start,
                                    children: [
                                      Row(
                                        children: [
                                          Expanded(
                                            child: Text(
                                              nombre,
                                              style: AppTypography.labelMedium.copyWith(
                                                fontWeight: FontWeight.w700,
                                                color: const Color(0xFF1E293B),
                                                fontSize: 13,
                                                height: 1.1,
                                              ),
                                              overflow: TextOverflow.ellipsis,
                                              maxLines: 1,
                                            ),
                                          ),
                                          const SizedBox(width: 8),
                                          Container(
                                            padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                                            decoration: BoxDecoration(
                                              color: activo ? const Color(0xFFD1FAE5) : const Color(0xFFF3F4F6),
                                              borderRadius: BorderRadius.circular(4),
                                            ),
                                            child: Text(
                                              activo ? 'ACTIVO' : 'INACTIVO',
                                              style: AppTypography.labelSmall.copyWith(
                                                fontWeight: FontWeight.bold,
                                                color: activo ? const Color(0xFF047857) : const Color(0xFF6B7280),
                                                fontSize: 10,
                                              ),
                                            ),
                                          ),
                                        ],
                                      ),
                                      const SizedBox(height: 2),
                                      if (stock <= stockMinimo)
                                        Padding(
                                          padding: const EdgeInsets.only(bottom: 2),
                                          child: Row(
                                            children: [
                                              const Icon(Icons.warning_amber_rounded, color: Color(0xFFCA8A04), size: 16),
                                              const SizedBox(width: 4),
                                              Text(
                                                'Stock bajo! Mín: $stockMinimo',
                                                style: AppTypography.bodySmall.copyWith(color: const Color(0xFFCA8A04), fontWeight: FontWeight.w600),
                                              ),
                                            ],
                                          ),
                                        ),
                                      Wrap(
                                        spacing: 16, runSpacing: 4,
                                        children: [
                                          RichText(
                                            text: TextSpan(
                                              style: AppTypography.bodySmall.copyWith(color: const Color(0xFF64748B)),
                                              children: [
                                                const TextSpan(text: 'Stock: '),
                                                TextSpan(text: '$stock', style: AppTypography.bodySmall.copyWith(fontWeight: FontWeight.w600, color: colorStock)),
                                              ],
                                            ),
                                          ),
                                          RichText(
                                            text: TextSpan(
                                              style: AppTypography.bodySmall.copyWith(color: const Color(0xFF64748B)),
                                              children: [
                                                const TextSpan(text: 'Compra: '),
                                                TextSpan(text: 'RD\$ $precioCompra', style: AppTypography.bodySmall.copyWith(fontWeight: FontWeight.w600, color: const Color(0xFF10B981))),
                                              ],
                                            ),
                                          ),
                                        ],
                                      ),
                                      const SizedBox(height: 2),
                                      Wrap(
                                        spacing: 12, runSpacing: 4,
                                        children: [
                                          RichText(
                                            text: TextSpan(
                                              style: AppTypography.bodySmall.copyWith(color: const Color(0xFF64748B)),
                                              children: [
                                                const TextSpan(text: 'SKU: '),
                                                TextSpan(text: codigo, style: AppTypography.bodySmall.copyWith(fontWeight: FontWeight.w600, color: const Color(0xFF1E293B))),
                                              ],
                                            ),
                                          ),
                                          RichText(
                                            text: TextSpan(
                                              style: AppTypography.bodySmall.copyWith(color: const Color(0xFF64748B)),
                                              children: [
                                                const TextSpan(text: 'Venta: '),
                                                TextSpan(text: 'RD\$ $precioVenta', style: AppTypography.bodySmall.copyWith(fontWeight: FontWeight.w600, color: const Color(0xFFEF4444))),
                                              ],
                                            ),
                                          ),
                                        ],
                                      ),
                                    ],
                                  ),
                                ),
                                Column(
                                  children: [
                                    IconButton(
                                      icon: const Icon(Icons.edit_outlined, color: Color(0xFF1E293B), size: 20),
                                      tooltip: 'Editar Producto',
                                      onPressed: () => context.push('/productos/$productoId/editar'),
                                    ),
                                    IconButton(
                                      icon: const Icon(Icons.delete_outline, color: Color(0xFFDC2626), size: 20),
                                      tooltip: 'Eliminar Producto',
                                      onPressed: () => ref.read(productoControllerProvider.notifier).eliminar(productoId),
                                    ),
                                  ],
                                ),
                              ],
                            ),
                          ),
                        );
                      },
                    );
                  },
                ),
              ),
            ],
          ),
          Positioned(
            bottom: 8,
            right: 8,
            child: FloatingActionButton(
              backgroundColor: const Color(0xFF1E293B),
              child: const Icon(Icons.add, color: Colors.white, size: 24),
              onPressed: () => context.push('/productos/nuevo'),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildSeccionKardex(BuildContext context) {
    final movimientosAsync = ref.watch(kardexPorProductoProvider(''));

    return Padding(
      padding: AppSpacing.allM,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Historial de Movimientos (Kardex)',
            style: AppTypography.h4.copyWith(color: const Color(0xFF1E293B)),
          ),
          const SizedBox(height: AppSpacing.m),
          Row(
            children: [
              Expanded(
                child: AppTextField(
                  hint: 'Buscar por producto, documento...',
                  onChanged: (v) => setState(() => _filtroKardex = v),
                ),
              ),
              const SizedBox(width: AppSpacing.m),
              Expanded(
                child: AppDropdown<TipoMovimiento>(
                  initialValue: _filtroTipoKardex,
                  hint: 'Tipo Movimiento',
                  items: TipoMovimiento.values
                      .map((t) => DropdownMenuItem(value: t, child: Text(t.name.toUpperCase())))
                      .toList(),
                  onChanged: (v) => setState(() => _filtroTipoKardex = v),
                ),
              ),
            ],
          ),
          const SizedBox(height: AppSpacing.m),
          Expanded(
            child: movimientosAsync.when(
              loading: () => const Center(child: CircularProgressIndicator()),
              error: (e, _) => Center(
                child: Text('Error: $e', style: AppTypography.bodyMedium.copyWith(color: Colors.red)),
              ),
              data: (movimientos) {
                final filtrados = movimientos.where((m) {
                  final docRef = m.documentoReferencia ?? '';
                  final coincideTexto = m.productoId.toString().contains(_filtroKardex) || docRef.contains(_filtroKardex);
                  final coincideTipo = _filtroTipoKardex == null || m.tipoMovimiento == _filtroTipoKardex;
                  return coincideTexto && coincideTipo;
                }).toList();

                if (filtrados.isEmpty) {
                  return Center(
                    child: Padding(
                      padding: AppSpacing.allL,
                      child: Text(
                        'Aquí aparecerá el historial completo de entradas, salidas y ajustes de inventario.',
                        textAlign: TextAlign.center,
                        style: AppTypography.bodyMedium.copyWith(color: const Color(0xFF64748B)),
                      ),
                    ),
                  );
                }

                return ListView.separated(
                  padding: EdgeInsets.zero,
                  itemCount: filtrados.length,
                  separatorBuilder: (_, __) => const SizedBox(height: AppSpacing.s),
                  itemBuilder: (_, i) {
                    final m = filtrados[i];
                    final colorTipo = switch (m.tipoMovimiento) {
                      TipoMovimiento.entrada => const Color(0xFF10B981),
                      TipoMovimiento.salida => const Color(0xFFEF4444),
                      TipoMovimiento.ajuste => const Color(0xFFF59E0B),
                      _ => const Color(0xFF6366F1),
                    };
                    final fecha = m.fechaMovimiento;
                    final dia = fecha?.day ?? '-';
                    final mes = fecha?.month ?? '-';
                    final anio = fecha?.year ?? '-';
                    final docRef = m.documentoReferencia ?? 'Sin doc';

                    return Card(
                      elevation: 2,
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                      child: Padding(
                        padding: AppSpacing.allM,
                        child: Row(
                          children: [
                            Container(
                              width: 8, height: 60,
                              decoration: BoxDecoration(color: colorTipo, borderRadius: BorderRadius.circular(4)),
                            ),
                            const SizedBox(width: AppSpacing.m),
                            Expanded(
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text(
                                    m.tipoMovimiento.name.toUpperCase(),
                                    style: AppTypography.labelLarge.copyWith(fontWeight: FontWeight.w800, color: colorTipo),
                                  ),
                                  const SizedBox(height: AppSpacing.xs),
                                  Text(
                                    'Producto: ${m.productoId}\nDocumento: $docRef',
                                    style: AppTypography.bodySmall.copyWith(color: const Color(0xFF64748B)),
                                  ),
                                  const SizedBox(height: AppSpacing.xs),
                                  Text(
                                    'Cantidad: ${m.cantidad}  |  Saldo: ${m.saldoAnterior} → ${m.saldoNuevo}',
                                    style: AppTypography.bodySmall.copyWith(fontWeight: FontWeight.w600, color: const Color(0xFF1E293B)),
                                  ),
                                ],
                              ),
                            ),
                            const SizedBox(width: AppSpacing.s),
                            Column(
                              crossAxisAlignment: CrossAxisAlignment.end,
                              children: [
                                Text(
                                  '$dia/$mes/$anio',
                                  style: AppTypography.bodySmall.copyWith(color: const Color(0xFF94A3B8)),
                                ),
                                const SizedBox(height: AppSpacing.xs),
                                Container(
                                  padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                                  decoration: BoxDecoration(
                                    color: colorTipo.withValues(alpha: 0.1),
                                    borderRadius: BorderRadius.circular(6),
                                  ),
                                  child: Text(
                                    m.tipoMovimiento == TipoMovimiento.entrada ? 'Entrante' : 'Saliente',
                                    style: AppTypography.labelSmall.copyWith(color: colorTipo, fontWeight: FontWeight.bold),
                                  ),
                                ),
                              ],
                            ),
                          ],
                        ),
                      ),
                    );
                  },
                );
              },
            ),
          ),
        ],
      ),
    );
  }
}
