import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:fiscogest_rd/core/database/database_provider.dart';
import 'package:fiscogest_rd/core/servicios_transversales/operaciones_salida_service.dart';
import 'package:fiscogest_rd/features/inventario/data/repositories/salida_repository_impl.dart';
import 'package:fiscogest_rd/features/inventario/domain/entities/salida.dart';
import 'package:fiscogest_rd/features/inventario/domain/interfaces/i_salida_repository.dart';
import 'package:fiscogest_rd/features/inventario/presentation/providers/producto_providers.dart';

/// Proveedor del Repositorio de Salidas
final salidaRepositoryProvider = Provider<ISalidaRepository>((ref) {
  // ✅ Única fuente de verdad para la base de datos
  final db = ref.watch(databaseProvider);
  return SalidaRepositoryImpl(db);
});

/// Proveedor del Servicio de Operaciones de Salida
final operacionesSalidaServiceProvider = Provider<OperacionesSalidaService>((ref) {
  return OperacionesSalidaService(
    salidaRepository: ref.watch(salidaRepositoryProvider),
    productoRepository: ref.watch(productoRepositoryProvider),
    db: ref.watch(databaseProvider),
  );
});

/// Historial de salidas
final historialSalidasProvider = FutureProvider<List<Salida>>((ref) async {
  final repo = ref.watch(salidaRepositoryProvider);
  return await repo.obtenerHistorialSalidas();
});

/// Controlador de Salidas: solo gestiona estado y flujo UI, NUNCA lógica de negocio
class SalidaController extends StateNotifier<AsyncValue<void>> {
  SalidaController(this._operacionesSalida, this._ref) : super(const AsyncValue.data(null));

  final OperacionesSalidaService _operacionesSalida;
  final Ref _ref;

  Future<void> registrarSalida({
    required int productoId,
    required int cantidad,
    required String motivo,
    required String usuario,
  }) async {
    state = const AsyncValue.loading();
    try {
      // ✅ Delegación exclusiva al servicio (respeta flujo oficial)
      await _operacionesSalida.registrarSalidaConValidacionStock(
        productoId: productoId,
        cantidad: cantidad,
        motivo: motivo,
        usuario: usuario,
      );

      // ✅ Refresco selectivo sin repeticiones innecesarias
      _ref.invalidate(productoControllerProvider);
      _ref.invalidate(historialSalidasProvider);

      state = const AsyncValue.data(null);
    } catch (e, st) {
      state = AsyncValue.error(e, st);
    }
  }
}

final salidaControllerProvider = StateNotifierProvider<SalidaController, AsyncValue<void>>((ref) {
  final servicio = ref.watch(operacionesSalidaServiceProvider);
  return SalidaController(servicio, ref);
});