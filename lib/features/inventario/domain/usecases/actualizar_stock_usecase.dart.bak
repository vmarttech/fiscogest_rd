import 'package:fiscogest_rd/features/inventario/domain/enums/tipo_movimiento.dart';
import 'package:fiscogest_rd/features/inventario/domain/services/i_inventario_service.dart';
import 'package:fiscogest_rd/features/inventario/domain/interfaces/ikardex_repository.dart';

class ActualizarStockUseCase {
  ActualizarStockUseCase(this.servicio, this._kardexRepo);
  final IInventarioService servicio;
  final IKardexRepository _kardexRepo;

  Future<void> ejecutar({
    required int productoId,
    required double cantidad,
    required TipoMovimiento tipo,
    required double costoUnitario,
    required int usuarioId,
    String? docReferencia,
    String? observacion,
  }) async {
    final saldoAnterior = await servicio.obtenerStockActual(productoId);

    if (tipo == TipoMovimiento.entrada) {
      await servicio.sumarStock(productoId, cantidad);
    } else {
      if(!await servicio.esStockSuficiente(productoId, cantidad)){
        throw Exception('No hay existencias disponibles para realizar la salida');
      }
      await servicio.restarStock(productoId, cantidad);
    }

    final saldoNuevo = tipo == TipoMovimiento.entrada
        ? saldoAnterior + cantidad
        : saldoAnterior - cantidad;
    final totalMovimiento = cantidad * costoUnitario;

    // ✅ CORREGIDO: LLAMADA AJUSTADA A LA FIRMA REAL DEL REPOSITORIO
    await _kardexRepo.registrarMovimiento(
      productoId: productoId,
      tipoMovimiento: tipo,
      cantidad: cantidad,
      saldoAnterior: saldoAnterior,
      saldoNuevo: saldoNuevo,
      costoUnitario: costoUnitario,
      totalMovimiento: totalMovimiento,
      usuarioId: usuarioId,
      documentoReferencia: docReferencia,
      observacion: observacion,
    );
  }
}
