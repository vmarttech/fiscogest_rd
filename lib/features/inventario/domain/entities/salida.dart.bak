class Salida {
  Salida({
    this.id,
    required this.productoId,
    required this.cantidad,
    required this.motivo,
    required this.usuarioId,
    required this.fecha,
  });

  final int? id;
  final int productoId;
  final int cantidad;
  final String motivo;
  final String usuarioId;
  final DateTime fecha;
}