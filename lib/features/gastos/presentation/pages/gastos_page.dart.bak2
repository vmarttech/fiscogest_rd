import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:intl/intl.dart';
import 'package:fiscogest_rd/core/ui/app_breakpoints.dart';
import 'package:fiscogest_rd/core/ui/app_button.dart';
import 'package:fiscogest_rd/core/ui/app_card.dart';
import 'package:fiscogest_rd/core/ui/app_colors.dart';
import 'package:fiscogest_rd/core/ui/app_formatters.dart';
import 'package:fiscogest_rd/core/ui/app_layout.dart';
import 'package:fiscogest_rd/core/ui/app_scaffold.dart';
import 'package:fiscogest_rd/core/ui/app_textfield.dart';
import 'package:fiscogest_rd/core/ui/app_typography.dart';
import 'package:fiscogest_rd/core/ui/fisco_gest_notifications.dart';
import 'package:fiscogest_rd/features/gastos/domain/entities/gasto.dart';
import 'package:fiscogest_rd/features/gastos/presentation/providers/gastos_providers.dart';

/// Lista + alta/edición de gastos — mismo lenguaje visual que Facturación / NC.
class GastosPage extends ConsumerStatefulWidget {
  const GastosPage({super.key});

  static const String routeName = 'gastos';

  @override
  ConsumerState<GastosPage> createState() => _GastosPageState();
}

class _GastosPageState extends ConsumerState<GastosPage> {
  final _fmt = DateFormat('dd/MM/yyyy');
  String _filtro = '';

  static const _cats = [
    'General',
    'Alquiler',
    'Servicios',
    'Nómina',
    'Transporte',
    'Mantenimiento',
    'Impuestos',
    'Marketing',
    'Otros',
  ];
  static const _formas = [
    'efectivo',
    'transferencia',
    'tarjeta',
    'cheque',
    'otro',
  ];

  Color _chipColor(String cat) {
    switch (cat.toLowerCase()) {
      case 'alquiler':
        return const Color(0xFF7C3AED);
      case 'servicios':
        return AppColors.info;
      case 'nómina':
      case 'nomina':
        return const Color(0xFF0F766E);
      case 'impuestos':
        return AppColors.error;
      case 'marketing':
        return const Color(0xFF6366F1);
      case 'transporte':
        return const Color(0xFFEA580C);
      case 'mantenimiento':
        return const Color(0xFF0891B2);
      default:
        return AppColors.primary;
    }
  }

  Future<void> _abrirForm({Gasto? edit}) async {
    final mobile = MediaQuery.sizeOf(context).width < 600;
    final descCtrl = TextEditingController(text: edit?.descripcion ?? '');
    final montoCtrl = TextEditingController(
      text: edit != null ? edit.monto.toStringAsFixed(2) : '',
    );
    final notasCtrl = TextEditingController(text: edit?.notas ?? '');
    var categoria = edit?.categoria ?? 'General';
    var formaPago = edit?.formaPago ?? 'efectivo';
    var fecha = edit?.fecha ?? DateTime.now();

    Future<void> guardar(BuildContext ctx) async {
      final desc = descCtrl.text.trim();
      final monto = double.tryParse(montoCtrl.text.replaceAll(',', '.')) ?? 0;
      if (desc.isEmpty || monto <= 0) {
        FiscoGestNotifications.show(
          const SnackBar(
            content: Text('Descripción y monto válidos son requeridos'),
            backgroundColor: AppColors.error,
          ),
        );
        return;
      }
      final g = Gasto(
        id: edit?.id,
        fecha: DateTime(fecha.year, fecha.month, fecha.day),
        categoria: categoria,
        descripcion: desc,
        monto: monto,
        formaPago: formaPago,
        notas: notasCtrl.text.trim().isEmpty ? null : notasCtrl.text.trim(),
        creadoEn: edit?.creadoEn ?? DateTime.now(),
        actualizadoEn: DateTime.now(),
      );
      await ref.read(gastosRepositoryProvider).guardar(g);
      ref.invalidate(gastosListaProvider);
      if (ctx.mounted) Navigator.pop(ctx);
      FiscoGestNotifications.show(
        SnackBar(
          content: Text(
            edit == null ? 'Gasto registrado' : 'Gasto actualizado',
          ),
          backgroundColor: AppColors.success,
        ),
      );
    }

    Widget sectionTitle(String t) => Padding(
          padding: const EdgeInsets.only(bottom: 8, top: 4),
          child: Text(
            t.toUpperCase(),
            style: const TextStyle(
              fontSize: 11,
              fontWeight: FontWeight.w800,
              letterSpacing: 0.6,
              color: Color(0xFF64748B),
            ),
          ),
        );

    Widget formBody(void Function(void Function()) setLocal) {
      return SingleChildScrollView(
        padding: EdgeInsets.fromLTRB(
          mobile ? 16 : 20,
          8,
          mobile ? 16 : 20,
          16,
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            sectionTitle('Documento'),
            Material(
              color: const Color(0xFFF8FAFC),
              borderRadius: BorderRadius.circular(12),
              child: InkWell(
                borderRadius: BorderRadius.circular(12),
                onTap: () async {
                  final d = await showDatePicker(
                    context: context,
                    initialDate: fecha,
                    firstDate: DateTime(2020),
                    lastDate: DateTime.now().add(const Duration(days: 1)),
                  );
                  if (d != null) setLocal(() => fecha = d);
                },
                child: Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 14,
                    vertical: 14,
                  ),
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(color: const Color(0xFFE2E8F0)),
                  ),
                  child: Row(
                    children: [
                      Container(
                        width: 36,
                        height: 36,
                        decoration: BoxDecoration(
                          color: AppColors.primary.withValues(alpha: 0.1),
                          borderRadius: BorderRadius.circular(10),
                        ),
                        child: const Icon(
                          Icons.calendar_today_outlined,
                          size: 18,
                          color: AppColors.primary,
                        ),
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            const Text(
                              'Fecha del gasto',
                              style: TextStyle(
                                fontSize: 11,
                                fontWeight: FontWeight.w600,
                                color: Color(0xFF64748B),
                              ),
                            ),
                            const SizedBox(height: 2),
                            Text(
                              _fmt.format(fecha),
                              style: const TextStyle(
                                fontSize: 15,
                                fontWeight: FontWeight.w800,
                                color: Color(0xFF0F172A),
                              ),
                            ),
                          ],
                        ),
                      ),
                      const Icon(Icons.chevron_right, color: Color(0xFF94A3B8)),
                    ],
                  ),
                ),
              ),
            ),
            const SizedBox(height: 16),
            sectionTitle('Clasificación'),
            DropdownButtonFormField<String>(
              initialValue: categoria,
              decoration: InputDecoration(
                labelText: 'Categoría',
                filled: true,
                fillColor: Colors.white,
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                ),
              ),
              items: [
                for (final c in _cats)
                  DropdownMenuItem(value: c, child: Text(c)),
              ],
              onChanged: (v) {
                if (v != null) setLocal(() => categoria = v);
              },
            ),
            const SizedBox(height: 12),
            DropdownButtonFormField<String>(
              initialValue: formaPago,
              decoration: InputDecoration(
                labelText: 'Forma de pago',
                filled: true,
                fillColor: Colors.white,
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                ),
              ),
              items: [
                for (final f in _formas)
                  DropdownMenuItem(value: f, child: Text(f)),
              ],
              onChanged: (v) {
                if (v != null) setLocal(() => formaPago = v);
              },
            ),
            const SizedBox(height: 16),
            sectionTitle('Detalle'),
            AppTextField(label: 'Descripción *', controller: descCtrl),
            const SizedBox(height: 12),
            AppTextField(
              label: 'Monto *',
              controller: montoCtrl,
              keyboardType: const TextInputType.numberWithOptions(
                decimal: true,
              ),
            ),
            const SizedBox(height: 12),
            AppTextField(label: 'Notas', controller: notasCtrl),
            const SizedBox(height: 16),
            // Resumen tipo total factura/NC
            Container(
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                color: const Color(0xFFECFDF5),
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: AppColors.primary.withValues(alpha: 0.25),
                ),
              ),
              child: Row(
                children: [
                  const Icon(Icons.payments_outlined, color: AppColors.primary),
                  const SizedBox(width: 10),
                  const Expanded(
                    child: Text(
                      'TOTAL DEL GASTO',
                      style: TextStyle(
                        fontSize: 11,
                        fontWeight: FontWeight.w800,
                        letterSpacing: 0.5,
                        color: Color(0xFF64748B),
                      ),
                    ),
                  ),
                  Text(
                    formatRd(
                      double.tryParse(montoCtrl.text.replaceAll(',', '.')) ??
                          0,
                    ),
                    style: const TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.w900,
                      color: Color(0xFF0F766E),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      );
    }

    Widget headerBar(BuildContext ctx) {
      return Padding(
        padding: const EdgeInsets.fromLTRB(16, 12, 8, 10),
        child: Row(
          children: [
            Container(
              width: 42,
              height: 42,
              decoration: BoxDecoration(
                color: AppColors.primary.withValues(alpha: 0.1),
                borderRadius: BorderRadius.circular(12),
              ),
              child: const Icon(
                Icons.receipt_long_rounded,
                color: AppColors.primary,
              ),
            ),
            const SizedBox(width: 12),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    edit == null ? 'Nuevo gasto' : 'Editar gasto',
                    style: const TextStyle(
                      fontSize: 17,
                      fontWeight: FontWeight.w900,
                      color: Color(0xFF0F172A),
                    ),
                  ),
                  const SizedBox(height: 2),
                  const Text(
                    'Egreso operativo · mismo flujo que un comprobante',
                    style: TextStyle(
                      fontSize: 12.5,
                      fontWeight: FontWeight.w500,
                      color: Color(0xFF64748B),
                    ),
                  ),
                ],
              ),
            ),
            IconButton(
              onPressed: () => Navigator.pop(ctx),
              icon: const Icon(Icons.close),
            ),
          ],
        ),
      );
    }

    if (mobile) {
      await showModalBottomSheet<void>(
        context: context,
        isScrollControlled: true,
        useSafeArea: true,
        backgroundColor: Colors.white,
        shape: const RoundedRectangleBorder(
          borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
        ),
        builder: (ctx) {
          return StatefulBuilder(
            builder: (ctx, setLocal) {
              final media = MediaQuery.of(ctx);
              final availableHeight = media.size.height -
                  media.viewInsets.bottom -
                  media.padding.top -
                  media.padding.bottom;
              return Padding(
                padding: EdgeInsets.only(bottom: media.viewInsets.bottom),
                child: SafeArea(
                  top: false,
                  child: SizedBox(
                    height: (availableHeight * 0.96)
                        .clamp(0.0, availableHeight)
                        .toDouble(),
                    child: Column(
                      children: [
                        headerBar(ctx),
                        const Divider(height: 1, color: Color(0xFFE2E8F0)),
                        Expanded(child: formBody(setLocal)),
                        const Divider(height: 1, color: Color(0xFFE2E8F0)),
                        Padding(
                          padding: const EdgeInsets.fromLTRB(12, 10, 12, 12),
                          child: Row(
                            children: [
                              Expanded(
                                child: SizedBox(
                                  height: 48,
                                  child: OutlinedButton(
                                    onPressed: () => Navigator.pop(ctx),
                                    style: OutlinedButton.styleFrom(
                                      foregroundColor: AppColors.textSecondary,
                                      side: const BorderSide(
                                        color: Color(0xFFE2E8F0),
                                      ),
                                      shape: RoundedRectangleBorder(
                                        borderRadius: BorderRadius.circular(14),
                                      ),
                                    ),
                                    child: const Text('Cancelar'),
                                  ),
                                ),
                              ),
                              const SizedBox(width: 8),
                              Expanded(
                                child: SizedBox(
                                  height: 48,
                                  child: AppButton(
                                    text: 'Guardar',
                                    onPressed: () => guardar(ctx),
                                  ),
                                ),
                              ),
                            ],
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              );
            },
          );
        },
      );
    } else {
      await showDialog<void>(
        context: context,
        barrierDismissible: false,
        builder: (ctx) {
          return StatefulBuilder(
            builder: (ctx, setLocal) {
              return Dialog(
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(16),
                ),
                clipBehavior: Clip.antiAlias,
                child: SizedBox(
                  width: 520,
                  height: MediaQuery.sizeOf(ctx).height * 0.78,
                  child: Column(
                    children: [
                      headerBar(ctx),
                      const Divider(height: 1, color: Color(0xFFE2E8F0)),
                      Expanded(child: formBody(setLocal)),
                      const Divider(height: 1, color: Color(0xFFE2E8F0)),
                      Padding(
                        padding: const EdgeInsets.fromLTRB(16, 12, 16, 16),
                        child: Row(
                          children: [
                            TextButton(
                              onPressed: () => Navigator.pop(ctx),
                              child: const Text('Cancelar'),
                            ),
                            const Spacer(),
                            FilledButton.icon(
                              onPressed: () => guardar(ctx),
                              icon: const Icon(Icons.check, size: 18),
                              label: const Text('Guardar gasto'),
                              style: FilledButton.styleFrom(
                                backgroundColor: AppColors.primary,
                                foregroundColor: Colors.white,
                                padding: const EdgeInsets.symmetric(
                                  horizontal: 18,
                                  vertical: 14,
                                ),
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(12),
                                ),
                              ),
                            ),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),
              );
            },
          );
        },
      );
    }
  }

  Future<void> _eliminar(Gasto g) async {
    final ok = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Eliminar gasto'),
        content: Text('Eliminar "${g.descripcion}" (${formatRd(g.monto)})?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx, false),
            child: const Text('Cancelar'),
          ),
          TextButton(
            onPressed: () => Navigator.pop(ctx, true),
            style: TextButton.styleFrom(foregroundColor: AppColors.error),
            child: const Text('Eliminar'),
          ),
        ],
      ),
    );
    if (ok == true && g.id != null) {
      await ref.read(gastosRepositoryProvider).eliminar(g.id!);
      ref.invalidate(gastosListaProvider);
    }
  }

  @override
  Widget build(BuildContext context) {
    final mobile = AppBreakpoints.isMobile(context);
    final desktop = AppBreakpoints.isDesktop(context);
    final async = ref.watch(gastosListaProvider);

    return AppScaffold(
      title: 'GASTOS',
      subtitle: 'Egresos operativos del negocio',
      showAppBar: !desktop,
      actions: [
        if (!mobile)
          Padding(
            padding: const EdgeInsets.only(right: 8),
            child: FilledButton.icon(
              onPressed: () => _abrirForm(),
              icon: const Icon(Icons.add, size: 18),
              label: const Text('Nuevo gasto'),
              style: FilledButton.styleFrom(
                backgroundColor: AppColors.primary,
                foregroundColor: Colors.white,
                visualDensity: VisualDensity.compact,
                padding: const EdgeInsets.symmetric(horizontal: 14),
              ),
            ),
          ),
      ],
      floatingActionButton: mobile
          ? FloatingActionButton.extended(
              onPressed: () => _abrirForm(),
              backgroundColor: AppColors.primary,
              foregroundColor: Colors.white,
              icon: const Icon(Icons.add),
              label: const Text('Nuevo'),
            )
          : null,
      body: SafeArea(
        child: Align(
          alignment: Alignment.topCenter,
          child: async.when(
            loading: () => const Center(child: CircularProgressIndicator()),
            error: (e, _) => Center(child: Text('Error: $e')),
            data: (lista) {
              final filtrados = _filtro.isEmpty
                  ? lista
                  : lista
                      .where(
                        (g) =>
                            g.descripcion.toLowerCase().contains(_filtro) ||
                            g.categoria.toLowerCase().contains(_filtro) ||
                            g.formaPago.toLowerCase().contains(_filtro),
                      )
                      .toList();
              final total =
                  filtrados.fold<double>(0, (s, g) => s + g.monto);

              return AppLayout.centerConstrained(
                maxWidth: desktop ? 1100 : 720,
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Padding(
                      padding: EdgeInsets.fromLTRB(
                        mobile ? 16 : 24,
                        desktop ? 20 : 12,
                        mobile ? 16 : 24,
                        8,
                      ),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                          if (desktop) ...[
                            const Text(
                              'Gastos',
                              style: TextStyle(
                                fontSize: 22,
                                fontWeight: FontWeight.w900,
                                color: Color(0xFF0F172A),
                                letterSpacing: -0.3,
                              ),
                            ),
                            const SizedBox(height: 4),
                            const Text(
                              'Registro de egresos operativos, por categoría y forma de pago.',
                              style: TextStyle(
                                fontSize: 13.5,
                                fontWeight: FontWeight.w500,
                                color: Color(0xFF64748B),
                              ),
                            ),
                            const SizedBox(height: 18),
                          ],
                          // KPI compactos (como pills de Facturación; sin estirar)
                          Wrap(
                            spacing: 10,
                            runSpacing: 10,
                            children: [
                              SizedBox(
                                width: 200,
                                child: _GastosKpi(
                                  icon: Icons.receipt_long_outlined,
                                  value: '${filtrados.length}',
                                  label: 'REGISTROS',
                                  bg: const Color(0xFFECFDF5),
                                  fg: AppColors.success,
                                ),
                              ),
                              SizedBox(
                                width: 240,
                                child: _GastosKpi(
                                  icon: Icons.payments_outlined,
                                  value: formatRd(total),
                                  label: 'TOTAL FILTRADO',
                                  bg: const Color(0xFFFEE2E2),
                                  fg: AppColors.error,
                                ),
                              ),
                            ],
                          ),
                          const SizedBox(height: 14),
                          TextField(
                            decoration: InputDecoration(
                              hintText:
                                  'Buscar descripción, categoría o forma de pago…',
                              prefixIcon: const Icon(Icons.search),
                              filled: true,
                              fillColor: Colors.white,
                              border: OutlineInputBorder(
                                borderRadius: BorderRadius.circular(12),
                                borderSide: const BorderSide(
                                  color: Color(0xFFE2E8F0),
                                ),
                              ),
                              enabledBorder: OutlineInputBorder(
                                borderRadius: BorderRadius.circular(12),
                                borderSide: const BorderSide(
                                  color: Color(0xFFE2E8F0),
                                ),
                              ),
                              isDense: true,
                            ),
                            onChanged: (v) =>
                                setState(() => _filtro = v.toLowerCase()),
                          ),
                        ],
                      ),
                    ),
                    Expanded(
                      child: Padding(
                        padding: EdgeInsets.fromLTRB(
                          mobile ? 16 : 24,
                          4,
                          mobile ? 16 : 24,
                          24,
                        ),
                        child: AppCard(
                          padding: EdgeInsets.zero,
                          child: filtrados.isEmpty
                              ? Center(
                                  child: Padding(
                                    padding: const EdgeInsets.all(32),
                                    child: Column(
                                      mainAxisSize: MainAxisSize.min,
                                      children: [
                                        Icon(
                                          Icons.money_off_csred_outlined,
                                          size: 48,
                                          color: AppColors.textSecondary
                                              .withValues(alpha: 0.5),
                                        ),
                                        const SizedBox(height: 12),
                                        Text(
                                          'No hay gastos registrados',
                                          style: AppTypography.bodyMedium
                                              .copyWith(
                                            color: AppColors.textSecondary,
                                            fontWeight: FontWeight.w600,
                                          ),
                                        ),
                                        const SizedBox(height: 8),
                                        TextButton.icon(
                                          onPressed: () => _abrirForm(),
                                          icon: const Icon(Icons.add, size: 18),
                                          label: const Text('Registrar gasto'),
                                        ),
                                      ],
                                    ),
                                  ),
                                )
                              : ListView.separated(
                                  itemCount: filtrados.length,
                                  separatorBuilder: (_, __) => const Divider(
                                    height: 1,
                                    color: Color(0xFFF1F5F9),
                                  ),
                                  itemBuilder: (_, i) {
                                    final g = filtrados[i];
                                    final chip = _chipColor(g.categoria);
                                    return Material(
                                      color: Colors.white,
                                      child: InkWell(
                                        onTap: () => _abrirForm(edit: g),
                                        child: Padding(
                                          padding: const EdgeInsets.symmetric(
                                            horizontal: 14,
                                            vertical: 12,
                                          ),
                                          child: Row(
                                            children: [
                                              Container(
                                                width: 44,
                                                height: 44,
                                                decoration: BoxDecoration(
                                                  color: chip.withValues(
                                                    alpha: 0.12,
                                                  ),
                                                  borderRadius:
                                                      BorderRadius.circular(12),
                                                ),
                                                child: Icon(
                                                  Icons.money_off_csred_outlined,
                                                  color: chip,
                                                  size: 22,
                                                ),
                                              ),
                                              const SizedBox(width: 12),
                                              Expanded(
                                                child: Column(
                                                  crossAxisAlignment:
                                                      CrossAxisAlignment.start,
                                                  children: [
                                                    Text(
                                                      g.descripcion,
                                                      style: const TextStyle(
                                                        fontSize: 14.5,
                                                        fontWeight:
                                                            FontWeight.w800,
                                                        color: Color(0xFF0F172A),
                                                      ),
                                                    ),
                                                    const SizedBox(height: 4),
                                                    Wrap(
                                                      spacing: 6,
                                                      runSpacing: 4,
                                                      crossAxisAlignment:
                                                          WrapCrossAlignment
                                                              .center,
                                                      children: [
                                                        _MiniChip(
                                                          label: g.categoria,
                                                          color: chip,
                                                        ),
                                                        Text(
                                                          _fmt.format(g.fecha),
                                                          style: const TextStyle(
                                                            fontSize: 12,
                                                            fontWeight:
                                                                FontWeight.w500,
                                                            color: Color(
                                                              0xFF64748B,
                                                            ),
                                                          ),
                                                        ),
                                                        Text(
                                                          '· ${g.formaPago}',
                                                          style: const TextStyle(
                                                            fontSize: 12,
                                                            fontWeight:
                                                                FontWeight.w500,
                                                            color: Color(
                                                              0xFF64748B,
                                                            ),
                                                          ),
                                                        ),
                                                      ],
                                                    ),
                                                  ],
                                                ),
                                              ),
                                              const SizedBox(width: 8),
                                              Column(
                                                crossAxisAlignment:
                                                    CrossAxisAlignment.end,
                                                children: [
                                                  Text(
                                                    formatRd(g.monto),
                                                    style: const TextStyle(
                                                      fontSize: 15,
                                                      fontWeight:
                                                          FontWeight.w900,
                                                      color: Color(0xFFDC2626),
                                                    ),
                                                  ),
                                                  IconButton(
                                                    visualDensity:
                                                        VisualDensity.compact,
                                                    tooltip: 'Eliminar',
                                                    icon: const Icon(
                                                      Icons.delete_outline,
                                                      size: 20,
                                                      color: AppColors.error,
                                                    ),
                                                    onPressed: () =>
                                                        _eliminar(g),
                                                  ),
                                                ],
                                              ),
                                            ],
                                          ),
                                        ),
                                      ),
                                    );
                                  },
                                ),
                        ),
                      ),
                    ),
                  ],
                ),
              );
            },
          ),
        ),
      ),
    );
  }
}

class _GastosKpi extends StatelessWidget {
  const _GastosKpi({
    required this.icon,
    required this.value,
    required this.label,
    required this.bg,
    required this.fg,
  });

  final IconData icon;
  final String value;
  final String label;
  final Color bg;
  final Color fg;

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
      decoration: BoxDecoration(
        color: bg,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: fg.withValues(alpha: 0.15)),
      ),
      child: Row(
        children: [
          Icon(icon, color: fg, size: 22),
          const SizedBox(width: 10),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  label,
                  style: TextStyle(
                    fontSize: 10,
                    fontWeight: FontWeight.w800,
                    letterSpacing: 0.5,
                    color: fg.withValues(alpha: 0.85),
                  ),
                ),
                const SizedBox(height: 2),
                Text(
                  value,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.w900,
                    color: fg,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

class _MiniChip extends StatelessWidget {
  const _MiniChip({required this.label, required this.color});

  final String label;
  final Color color;

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
      decoration: BoxDecoration(
        color: color.withValues(alpha: 0.12),
        borderRadius: BorderRadius.circular(6),
      ),
      child: Text(
        label,
        style: TextStyle(
          fontSize: 11,
          fontWeight: FontWeight.w800,
          color: color,
        ),
      ),
    );
  }
}
