class AjusteInventario {

  const AjusteInventario({
    this.id,
    required this.productoId,
    this.codigoBusqueda,
    required this.tipoAjuste,
    required this.cantidad,
    required this.motivo,
    this.observaciones, // ✅ ÚNICA LÍNEA AGREGADA
    required this.usuarioId,
    required this.fechaCreacion,
  });
  final int? id;
  final int productoId;
  final String? codigoBusqueda;
  final String tipoAjuste;
  final double cantidad;
  final String motivo;
  final String? observaciones; // ✅ ÚNICA LÍNEA AGREGADA
  final int usuarioId;
  final DateTime fechaCreacion;
}
