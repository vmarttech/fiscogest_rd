class _ConfigTab extends ConsumerStatefulWidget {
  const _ConfigTab();
  @override
  ConsumerState<_ConfigTab> createState() => _ConfigTabState();
}

class _ConfigTabState extends ConsumerState<_ConfigTab> {
  final _rnc = TextEditingController();
  final _razon = TextEditingController();
  final _rutaCert = TextEditingController();
  final _claveCert = TextEditingController();
  final _rutaXsd = TextEditingController();
  bool _habilitado = false;
  AmbienteDgii _ambiente = AmbienteDgii.deshabilitado;
  bool _loaded = false;

  @override
  void dispose() {
    _rnc.dispose();
    _razon.dispose();
    _rutaCert.dispose();
    _claveCert.dispose();
    _rutaXsd.dispose();
    super.dispose();
  }

  void _hydrate(EcfeConfig c) {
    if (_loaded) return;
    _habilitado = c.habilitado;
    _ambiente = c.ambiente;
    _rnc.text = c.rncEmisor;
    _razon.text = c.razonSocialEmisor;
    _rutaCert.text = c.rutaCertificado;
    _claveCert.clear(); // La clave guardada nunca se precarga en la interfaz.
    _rutaXsd.text = c.xsdVersion;
    _loaded = true;
  }

  Future<void> _guardar() async {
    final c = EcfeConfig(
      habilitado: _habilitado,
      ambiente: _ambiente,
      rncEmisor: _rnc.text.trim(),
      razonSocialEmisor: _razon.text.trim(),
      rutaCertificado: _rutaCert.text.trim(),
      claveCertificado: _claveCert.text,
      xsdVersion: _rutaXsd.text.trim(),
    );
    late final List<(String, bool, String)> checks;
    try {
      final repository = ref.read(ecfeRepositoryProvider);
      await repository.guardarConfig(c);

      // Leer lo persistido: si el campo quedó vacío, la clave anterior
      // se conserva y el checklist debe usar la configuración recuperada.
      final guardada = await repository.obtenerConfig();

      ref.invalidate(ecfeConfigProvider);
      ref.invalidate(ecfeHabilitadoProvider);
      _claveCert.clear();

      checks = await _evaluarChecklistConfig(guardada);
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'No se pudo guardar la configuración e-CF. '
            'Comprueba el almacenamiento seguro del sistema e inténtalo '
            'de nuevo. No se confirmó el guardado.',
          ),
          behavior: SnackBarBehavior.floating,
        ),
      );
      return;
    }
    if (!mounted) return;
    await showDialog<void>(
      context: context,
      builder: (ctx) {
        final todosOk = checks.every((e) => e.$2);
        return AlertDialog(
          title: Text(
            todosOk
                ? 'Configuración lista para e-CF'
                : 'Configuración guardada — revisar checklist',
          ),
          content: SizedBox(
            width: 420,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
