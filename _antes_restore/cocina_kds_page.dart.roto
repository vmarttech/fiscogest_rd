import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:share_plus/share_plus.dart';
import 'package:fiscogest_rd/core/database/app_database.dart';
import 'package:fiscogest_rd/features/gastronomia/data/services/gastronomia_service.dart';
import 'package:fiscogest_rd/features/gastronomia/presentation/providers/gastronomia_providers.dart';

final _lineasPedidoProvider =
    FutureProvider.family<List<PedidoGastronomiaLineaData>, int>((ref, pedidoId) =>
        ref.read(gastronomiaServiceProvider).lineasDePedido(pedidoId));

class CocinaKdsPage extends ConsumerStatefulWidget {
  const CocinaKdsPage({super.key});
  static const routeName = 'cocina-kds';
  @override
  ConsumerState<CocinaKdsPage> createState() => _CocinaKdsPageState();
}

class _CocinaKdsPageState extends ConsumerState<CocinaKdsPage> {
  Timer? _timer;

  @override
  void initState() {
    super.initState();
    _timer = Timer.periodic(const Duration(seconds: 15), (_) {
      if (mounted) ref.invalidate(pedidosGastroPendientesProvider);
    });
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  Future<void> _cambiarEstado(int pedidoId, String estado) async {
    await ref
        .read(gastronomiaServiceProvider)
        .actualizarEstadoPedido(pedidoId, estado);
    ref.invalidate(pedidosGastroPendientesProvider);
    if (mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Pedido #$pedidoId → $estado')));
    }
  }

  Future<void> _cancelar(int pedidoId) async {
    final ok = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Text('Cancelar pedido #$pedidoId?'),
        content: const Text('Esta acción no se puede deshacer.'),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(ctx, false),
              child: const Text('No')),
          FilledButton(
              onPressed: () => Navigator.pop(ctx, true),
              child: const Text('Sí, cancelar')),
        ],
      ),
    );
    if (ok == true) {
      await _cambiarEstado(pedidoId, EstadoPedidoGastro.cancelado);
    }
  }

  @override
  Widget build(BuildContext context) {
    final pedidosAsync = ref.watch(pedidosGastroPendientesProvider);
    return Scaffold(
      appBar: AppBar(
        title: const Text('Cocina · Pedidos activos'),
        actions: [
          IconButton(
            icon: const Icon(Icons.refresh),
            tooltip: 'Refrescar',
            onPressed: () =>
                ref.invalidate(pedidosGastroPendientesProvider),
          ),
        ],
      ),
      body: pedidosAsync.when(
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (e, _) => Center(child: Text('Error: $e')),
        data: (raw) {
          final list = (raw as List).cast<PedidoGastronomiaData>();
          if (list.isEmpty) {
            return const Center(
                child: Column(mainAxisSize: MainAxisSize.min, children: [
                  Icon(Icons.restaurant, size: 56, color: Colors.grey),
                  SizedBox(height: 12),
                  Text('Sin pedidos activos.',
                      style:
                          TextStyle(fontSize: 16, fontWeight: FontWeight.w600)),
                  Text(
                      'Los nuevos pedidos aparecerán aquí automáticamente.',
                      style: TextStyle(color: Colors.grey)),
                ]));
          }
          final ancho = MediaQuery.of(context).size.width;
          return GridView.builder(
            padding: const EdgeInsets.all(12),
            gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
              crossAxisCount: ancho >= 900 ? 3 : ancho >= 600 ? 2 : 1,
              childAspectRatio: 0.92,
              crossAxisSpacing: 10,
              mainAxisSpacing: 10,
            ),
            itemCount: list.length,
            itemBuilder: (ctx, i) => _TarjetaPedido(
              pedido: list[i],
              onEstado: _cambiarEstado,
              onCancelar: _cancelar,
            ),
          );
        },
      ),
    );
  }
}

class _TarjetaPedido extends ConsumerWidget {
  const _TarjetaPedido(
      {required this.pedido, required this.onEstado, required this.onCancelar});
  final PedidoGastronomiaData pedido;
  final void Function(int, String) onEstado;
  final void Function(int) onCancelar;

  Color _colorEstado(String e) {
    switch (e) {
      case 'pendiente':
        return const Color(0xFFE53935);
      case 'confirmado':
        return const Color(0xFFFFB300);
      case 'en_preparacion':
        return const Color(0xFF1E88E5);
      case 'en_camino':
        return const Color(0xFF8E24AA);
      case 'listo':
        return const Color(0xFF43A047);
      default:
        return Colors.grey;
    }
  }

  Future<void> _compartirComanda(WidgetRef ref) async {
    final lineas = await ref
        .read(gastronomiaServiceProvider)
        .lineasDePedido(pedido.id);
    final b = StringBuffer();
    b.writeln('=== COMANDA COCINA ===');
    b.writeln('Pedido #${pedido.id} · ${pedido.tipo.toUpperCase()}');
    b.writeln('Cliente: ${pedido.nombreCliente}');
    if ((pedido.mesa ?? '').isNotEmpty) b.writeln('Mesa: ${pedido.mesa}');
    b.writeln('Comensales: ${pedido.comensales}');
    if (pedido.notas.isNotEmpty) b.writeln('Notas: ${pedido.notas}');
    b.writeln('---');
    for (final l in lineas) {
      b.writeln('${l.cantidad.toInt()}x ${l.nombreSnapshot}');
      if (l.notas.isNotEmpty) b.writeln('   -> ${l.notas}');
    }
    b.writeln('=== FIN ===');
    await Share.share(b.toString(), subject: 'Comanda #${pedido.id}');
  }

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final color = _colorEstado(pedido.estado);
    final lineasAsync = ref.watch(_lineasPedidoProvider(pedido.id));
    return Container(
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: color.withValues(alpha: 0.5), width: 2),
        boxShadow: [
          BoxShadow(
              color: Colors.black.withValues(alpha: 0.06),
              blurRadius: 6,
              offset: const Offset(0, 2))
        ],
      ),
      padding: const EdgeInsets.all(12),
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(children: [
          Container(
              padding:
                  const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
              decoration: BoxDecoration(
                  color: color, borderRadius: BorderRadius.circular(8)),
              child: Text('#${pedido.id}',
                  style: const TextStyle(
                      color: Colors.white,
                      fontWeight: FontWeight.w800,
                      fontSize: 13))),
          const SizedBox(width: 6),
          Expanded(
              child: Text(pedido.tipo.toUpperCase(),
                  style: const TextStyle(
                      fontSize: 11,
                      fontWeight: FontWeight.w700,
                      letterSpacing: 0.5))),
          Text(
              '${pedido.fecha.hour}:${pedido.fecha.minute.toString().padLeft(2, '0')}',
              style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w700)),
        ]),
        const SizedBox(height: 6),
        Text(pedido.nombreCliente,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style:
                const TextStyle(fontWeight: FontWeight.w700, fontSize: 14)),
        if ((pedido.mesa ?? '').isNotEmpty || pedido.comensales > 1)
          Text(
            '${pedido.mesa != null && pedido.mesa!.isNotEmpty ? 'Mesa ${pedido.mesa} · ' : ''}${pedido.comensales} comensal(es)',
            style: const TextStyle(fontSize: 11, color: Colors.grey),
          ),
        if (pedido.notas.isNotEmpty)
          Text('✎ ${pedido.notas}',
              maxLines: 2,
              overflow: TextOverflow.ellipsis,
              style: TextStyle(fontSize: 11, color: Colors.red.shade700)),
        const Divider(height: 12),
        Expanded(
            child: lineasAsync.when(
          loading: () => const Center(child: LinearProgressIndicator()),
          error: (e, _) => Text('Error: $e', style: const TextStyle(fontSize: 11)),
          data: (lineas) => ListView.builder(
            shrinkWrap: true,
            itemCount: lineas.length,
            itemBuilder: (ctx, i) {
              final l = lineas[i];
              return Padding(
                  padding: const EdgeInsets.symmetric(vertical: 2),
                  child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
                    Text('${l.cantidad.toInt()}x ',
                        style: const TextStyle(
                            fontWeight: FontWeight.w800, fontSize: 13)),
                    Expanded(
                        child: Text(l.nombreSnapshot,
                            style: const TextStyle(fontSize: 13))),
                  ]));
            },
          ),
        )),
        const SizedBox(height: 6),
        Wrap(spacing: 6, runSpacing: 6, children: [
          if (pedido.estado == EstadoPedidoGastro.pendiente ||
              pedido.estado == EstadoPedidoGastro.confirmado)
            _Boton(
                icono: Icons.play_arrow,
                texto: 'En preparación',
                color: const Color(0xFF1E88E5),
                onTap: () => onEstado(pedido.id, EstadoPedidoGastro.enPreparacion)),
          if (pedido.estado == EstadoPedidoGastro.enPreparacion)
            _Boton(
                icono: Icons.check_circle,
                texto: 'Listo',
                color: const Color(0xFF43A047),
                onTap: () => onEstado(pedido.id, EstadoPedidoGastro.listo)),
          if (pedido.estado == EstadoPedidoGastro.enCamino ||
              pedido.estado == EstadoPedidoGastro.listo)
            _Boton(
                icono: Icons.thumb_up,
                texto: 'Entregado',
                color: const Color(0xFF43A047),
                onTap: () => onEstado(pedido.id, EstadoPedidoGastro.entregado)),
          _Boton(
              icono: Icons.share,
              texto: 'Comanda',
              color: Colors.grey.shade700,
              onTap: () => _compartirComanda(ref)),
          _Boton(
              icono: Icons.cancel,
              texto: 'Cancelar',
              color: Colors.red.shade600,
              onTap: () => onCancelar(pedido.id)),
        ]),
      ]),
    );
  }
}

class _Boton extends StatelessWidget {
  const _Boton(
      {required this.icono,
      required this.texto,
      required this.color,
      required this.onTap});
  final IconData icono;
  final String texto;
  final Color color;
  final VoidCallback onTap;
  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTap: onTap,
      borderRadius: BorderRadius.circular(8),
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
        decoration: BoxDecoration(
            color: color.withValues(alpha: 0.12),
            borderRadius: BorderRadius.circular(8),
            border: Border.all(color: color.withValues(alpha: 0.4))),
        child: Row(mainAxisSize: MainAxisSize.min, children: [
          Icon(icono, size: 14, color: color),
          const SizedBox(width: 4),
          Text(texto,
              style: TextStyle(
                  fontSize: 11, fontWeight: FontWeight.w700, color: color)),
        ]),
      ),
    );
  }
}
