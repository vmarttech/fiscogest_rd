import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';
import 'package:fiscogest_rd/core/database/app_database.dart';
import 'package:fiscogest_rd/features/gastronomia/presentation/providers/gastronomia_providers.dart';

class ReservasMesasPage extends ConsumerStatefulWidget {
  const ReservasMesasPage({super.key});
  static const route = '/gastronomia/reservas';

  @override
  ConsumerState<ReservasMesasPage> createState() => _ReservasMesasPageState();
}

class _ReservasMesasPageState extends ConsumerState<ReservasMesasPage> {
  String _filtro = 'todas';
  static const _mesas = [
    'M1', 'M2', 'M3', 'M4', 'M5', 'M6', 'M7', 'M8',
    'T1', 'T2', 'T3', 'Barra',
  ];

  @override
  Widget build(BuildContext context) {
    final async = ref.watch(reservasProximasProvider);
    return Scaffold(
      appBar: AppBar(
        title: const Text('Reservas de mesa'),
        actions: [
          IconButton(
            icon: const Icon(Icons.refresh),
            onPressed: () => ref.invalidate(reservasProximasProvider),
          ),
        ],
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => _editar(null),
        child: const Icon(Icons.add),
      ),
      body: Column(children: [
        Padding(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
          child: Wrap(spacing: 6, children: [
            ChoiceChip(
                label: const Text('Todas'),
                selected: _filtro == 'todas',
                onSelected: (_) => setState(() => _filtro = 'todas')),
            ChoiceChip(
                label: const Text('Hoy'),
                selected: _filtro == 'hoy',
                onSelected: (_) => setState(() => _filtro = 'hoy')),
            ChoiceChip(
                label: const Text('Pendientes'),
                selected: _filtro == 'pend',
                onSelected: (_) => setState(() => _filtro = 'pend')),
          ]),
        ),
        Expanded(
          child: async.when(
            loading: () => const Center(child: CircularProgressIndicator()),
            error: (e, _) => Center(child: Text('Error: $e')),
            data: (list) {
              final ahora = DateTime.now();
              final filtradas = list.where((r) {
                if (_filtro == 'hoy') {
                  return r.fechaHora.year == ahora.year &&
                      r.fechaHora.month == ahora.month &&
                      r.fechaHora.day == ahora.day;
                }
                if (_filtro == 'pend') {
                  return r.estado == 'reservada' || r.estado == 'confirmada';
                }
                return true;
              }).toList();
              if (filtradas.isEmpty) {
                return const Center(child: Text('Sin reservas en este filtro.'));
              }
              return ListView.builder(
                padding: const EdgeInsets.symmetric(vertical: 6),
                itemCount: filtradas.length,
                itemBuilder: (ctx, i) => _tarjeta(filtradas[i]),
              );
            },
          ),
        ),
      ]),
    );
  }

  Color _colorEstado(String e) {
    switch (e) {
      case 'confirmada':
        return Colors.green.shade100;
      case 'completada':
        return Colors.grey.shade200;
      case 'cancelada':
        return Colors.red.shade100;
      default:
        return Colors.orange.shade100;
    }
  }

  Widget _tarjeta(MesaReservaData r) {
    final hora =
        '${r.fechaHora.hour.toString().padLeft(2, '0')}:${r.fechaHora.minute.toString().padLeft(2, '0')}';
    final fecha = '${r.fechaHora.day}/${r.fechaHora.month}/${r.fechaHora.year}';
    return Card(
      margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
      child: ListTile(
        leading: CircleAvatar(
          backgroundColor: _colorEstado(r.estado),
          child: Text(r.mesa, style: const TextStyle(fontWeight: FontWeight.w800)),
        ),
        title: Text(
            '${r.nombreCliente.isEmpty ? 'Sin nombre' : r.nombreCliente} · $hora hs'),
        subtitle: Text(
            '$fecha · ${r.comensales} comensal(es)${r.telefono.isNotEmpty ? " · ${r.telefono}" : ''}${r.notas.isNotEmpty ? " · ${r.notas}" : ''}'),
        trailing: PopupMenuButton<String>(
          onSelected: (v) => _accion(r, v),
          itemBuilder: (_) => [
            if (r.estado == 'reservada')
              const PopupMenuItem(value: 'confirmar', child: Text('Confirmar')),
            if (r.estado == 'reservada' || r.estado == 'confirmada')
              const PopupMenuItem(value: 'completar', child: Text('Marcar servida')),
            const PopupMenuItem(value: 'editar', child: Text('Editar')),
            const PopupMenuItem(value: 'pedido', child: Text('Convertir en pedido')),
            const PopupMenuItem(value: 'cancelar', child: Text('Cancelar')),
          ],
        ),
      ),
    );
  }

  Future<void> _accion(MesaReservaData r, String v) async {
    final svc = ref.read(gastronomiaServiceProvider);
    switch (v) {
      case 'confirmar':
        await svc.confirmarReserva(r.id);
        break;
      case 'completar':
        await svc.completarReserva(r.id);
        break;
      case 'cancelar':
        await svc.cancelarReserva(r.id);
        break;
      case 'pedido':
        if (!mounted) return;
        final cli = Uri.encodeComponent(r.nombreCliente);
        await context.push('/gastronomia/venta-rapida?mesa=${r.mesa}&cliente=$cli');
        return;
      case 'editar':
        await _editar(r);
        return;
    }
    ref.invalidate(reservasProximasProvider);
  }

  Future<void> _editar(MesaReservaData? r) async {
    String mesa = r?.mesa ?? _mesas.first;
    final nombreCtrl = TextEditingController(text: r?.nombreCliente ?? '');
    final telCtrl = TextEditingController(text: r?.telefono ?? '');
    final notasCtrl = TextEditingController(text: r?.notas ?? '');
    int comensales = r?.comensales ?? 2;
    DateTime fechaHora = r?.fechaHora ?? DateTime.now().add(const Duration(hours: 1));
    if (!mounted) return;
    final ok = await showModalBottomSheet<bool>(
      context: context,
      isScrollControlled: true,
      builder: (ctx) => StatefulBuilder(
        builder: (ctx, setS) => Padding(
          padding: EdgeInsets.only(
              left: 16, right: 16, top: 16,
              bottom: MediaQuery.of(ctx).viewInsets.bottom + 16),
          child: SingleChildScrollView(
            child: Column(mainAxisSize: MainAxisSize.min, crossAxisAlignment: CrossAxisAlignment.stretch, children: [
              Text(r == null ? 'Nueva reserva' : 'Reserva #${r.id}',
                  style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
              const SizedBox(height: 12),
              const Text('MESA',
                  style: TextStyle(fontSize: 10, fontWeight: FontWeight.w700, color: Colors.grey)),
              const SizedBox(height: 6),
              Wrap(spacing: 6, children: [
                for (final m in _mesas)
                  ChoiceChip(
                    label: Text(m),
                    selected: mesa == m,
                    onSelected: (_) => setS(() => mesa = m),
                  ),
              ]),
              const SizedBox(height: 10),
              TextField(
                controller: nombreCtrl,
                decoration: const InputDecoration(labelText: 'Cliente', border: OutlineInputBorder(), isDense: true),
              ),
              const SizedBox(height: 8),
              TextField(
                controller: telCtrl,
                keyboardType: TextInputType.phone,
                decoration: const InputDecoration(labelText: 'Teléfono / WhatsApp', border: OutlineInputBorder(), isDense: true),
              ),
              const SizedBox(height: 8),
              Row(children: [
                const Text('Comensales'),
                const Spacer(),
                IconButton(
                    onPressed: comensales <= 1 ? null : () => setS(() => comensales--),
                    icon: const Icon(Icons.remove_circle_outline)),
                Text('$comensales', style: const TextStyle(fontWeight: FontWeight.w800)),
                IconButton(
                    onPressed: () => setS(() => comensales++),
                    icon: const Icon(Icons.add_circle_outline)),
              ]),
              ListTile(
                contentPadding: EdgeInsets.zero,
                leading: const Icon(Icons.event),
                title: Text(
                    '${fechaHora.day}/${fechaHora.month}/${fechaHora.year}  ${fechaHora.hour.toString().padLeft(2, '0')}:${fechaHora.minute.toString().padLeft(2, '0')}'),
                trailing: const Icon(Icons.edit),
                onTap: () async {
                  final d = await showDatePicker(
                    context: ctx,
                    initialDate: fechaHora,
                    firstDate: DateTime.now().subtract(const Duration(days: 30)),
                    lastDate: DateTime.now().add(const Duration(days: 60)),
                  );
                  if (d == null || !ctx.mounted) return;
                  final t = await showTimePicker(context: ctx, initialTime: TimeOfDay.fromDateTime(fechaHora));
                  setS(() => fechaHora = DateTime(d.year, d.month, d.day,
                      t?.hour ?? fechaHora.hour, t?.minute ?? fechaHora.minute));
                },
              ),
              TextField(
                controller: notasCtrl,
                maxLines: 2,
                decoration: const InputDecoration(labelText: 'Notas (opcional)', border: OutlineInputBorder(), isDense: true),
              ),
              const SizedBox(height: 12),
              FilledButton.icon(
                onPressed: () => Navigator.pop(ctx, true),
                icon: const Icon(Icons.check),
                label: const Text('Guardar reserva'),
              ),
            ]),
          ),
        ),
      ),
    );
    if (ok == true) {
      await ref.read(gastronomiaServiceProvider).guardarReserva(
            id: r?.id,
            mesa: mesa,
            nombreCliente: nombreCtrl.text.trim(),
            telefono: telCtrl.text.trim(),
            comensales: comensales,
            fechaHora: fechaHora,
            notas: notasCtrl.text.trim(),
            estado: r?.estado ?? 'reservada',
          );
      ref.invalidate(reservasProximasProvider);
    }
  }
}
