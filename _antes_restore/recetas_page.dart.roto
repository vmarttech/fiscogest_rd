import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:fiscogest_rd/core/database/app_database.dart';
import 'package:fiscogest_rd/features/gastronomia/presentation/providers/gastronomia_providers.dart';

class RecetasPage extends ConsumerStatefulWidget {
  const RecetasPage({super.key});
  static const route = '/gastronomia/recetas';
  @override
  ConsumerState<RecetasPage> createState() => _RecetasPageState();
}

class _RecetasPageState extends ConsumerState<RecetasPage> {
  int? _platoId;

  @override
  Widget build(BuildContext context) {
    final platosAsync = ref.watch(platosGastronomicosProvider);
    return Scaffold(
      appBar: AppBar(title: const Text('Recetas · Costo por plato')),
      body: platosAsync.when(
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (e, _) => Center(child: Text('Error: $e')),
        data: (platos) {
          if (platos.isEmpty) {
            return const Center(
                child: Text('No hay platos gastronómicos. Marca productos como gastronómicos en Catálogo.'));
          }
          final seleccionado =
              platos.where((p) => p.id == _platoId).cast<ProductoData?>().firstOrNull;
          return Row(children: [
            Expanded(
              flex: 3,
              child: ListView.builder(
                itemCount: platos.length,
                itemBuilder: (ctx, i) {
                  final p = platos[i];
                  return ListTile(
                    selected: p.id == _platoId,
                    leading: const Icon(Icons.restaurant),
                    title: Text(p.nombre),
                    subtitle: Text('Venta RD\$ ${(p.precioVenta ?? 0).toStringAsFixed(2)}'),
                    onTap: () => setState(() => _platoId = p.id),
                  );
                },
              ),
            ),
            const VerticalDivider(width: 1),
            Expanded(
              flex: 5,
              child: seleccionado == null
                  ? const Center(child: Text('Selecciona un plato.'))
                  : _DetallePlato(plato: seleccionado),
            ),
          ]);
        },
      ),
    );
  }
}

class _DetallePlato extends ConsumerStatefulWidget {
  const _DetallePlato({required this.plato});
  final ProductoData plato;
  @override
  ConsumerState<_DetallePlato> createState() => _DetallePlatoState();
}

class _DetallePlatoState extends ConsumerState<_DetallePlato> {
  @override
  Widget build(BuildContext context) {
    final recetaAsync = ref.watch(recetaPlatoProvider(widget.plato.id));
    final insumosAsync = ref.watch(insumosCandidatosProvider);
    return recetaAsync.when(
      loading: () => const Center(child: CircularProgressIndicator()),
      error: (e, _) => Center(child: Text('Error: $e')),
      data: (items) {
        return insumosAsync.when(
          loading: () => const Center(child: CircularProgressIndicator()),
          error: (e, _) => Center(child: Text('Error: $e')),
          data: (insumos) {
            double costo = 0;
            for (final it in items) {
              final insumo = insumos.where((p) => p.id == it.insumoProductoId).cast<ProductoData?>().firstOrNull;
              costo += it.cantidad * (insumo?.precioCompra ?? 0);
            }
            final venta = widget.plato.precioVenta ?? 0;
            final margen = venta - costo;
            final pct = venta <= 0 ? 0.0 : (margen / venta) * 100;
            return Column(children: [
              Padding(
                padding: const EdgeInsets.all(16),
                child: Row(children: [
                  Expanded(
                    child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                      Text(widget.plato.nombre, style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w800)),
                      const SizedBox(height: 8),
                      Wrap(spacing: 16, children: [
                        _dato('Costo receta', 'RD\$ ${costo.toStringAsFixed(2)}', Colors.red),
                        _dato('Precio venta', 'RD\$ ${venta.toStringAsFixed(2)}', Colors.blue),
                        _dato('Margen', 'RD\$ ${margen.toStringAsFixed(2)} (${pct.toStringAsFixed(0)}%)',
                            margen >= 0 ? Colors.green : Colors.red),
                      ]),
                    ]),
                  ),
                  FilledButton.icon(
                    onPressed: () => _agregar(itemList: items, insumos: insumos),
                    icon: const Icon(Icons.add),
                    label: const Text('Insumo'),
                  ),
                ]),
              ),
              const Divider(height: 1),
              Expanded(
                child: items.isEmpty
                    ? const Center(child: Text('Sin insumos en la receta. Agrega el primero.'))
                    : ListView.builder(
                        itemCount: items.length,
                        itemBuilder: (ctx, i) {
                          final it = items[i];
                          final insumo = insumos.where((p) => p.id == it.insumoProductoId).cast<ProductoData?>().firstOrNull;
                          final precio = insumo?.precioCompra ?? 0;
                          return ListTile(
                            title: Text(insumo?.nombre ?? 'Insumo #${it.insumoProductoId}'),
                            subtitle: Text('${it.cantidad.toStringAsFixed(2)} ${it.unidad} · costo unit. RD\$ ${precio.toStringAsFixed(2)}'),
                            trailing: Row(mainAxisSize: MainAxisSize.min, children: [
                              Text('RD\$ ${(it.cantidad * precio).toStringAsFixed(2)}'),
                              IconButton(
                                icon: const Icon(Icons.delete_outline, color: Colors.red),
                                onPressed: () async {
                                  await ref.read(gastronomiaServiceProvider).borrarRecetaItem(it.id);
                                  ref.invalidate(recetaPlatoProvider(widget.plato.id));
                                },
                              ),
                            ]),
                            onTap: () => _editar(it, insumo, insumos),
                          );
                        },
                      ),
              ),
            ]);
          },
        );
      },
    );
  }

  Widget _dato(String k, String v, Color c) => Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
    Text(k, style: const TextStyle(fontSize: 11, color: Colors.grey)),
    Text(v, style: TextStyle(fontSize: 15, fontWeight: FontWeight.w800, color: c)),
  ]);

  Future<void> _agregar({
    required List<RecetaIngredienteData> itemList,
    required List<ProductoData> insumos,
  }) async {
    if (insumos.isEmpty) return;
    int selId = insumos.first.id;
    final ctrl = TextEditingController(text: '1');
    String unidad = 'unidad';
    final ok = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Agregar insumo'),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          DropdownButtonFormField<int>(
            initialValue: selId,
            isExpanded: true,
            items: [
              for (final p in insumos)
                DropdownMenuItem(value: p.id, child: Text(p.nombre, overflow: TextOverflow.ellipsis)),
            ],
            onChanged: (v) => selId = v!,
          ),
          const SizedBox(height: 8),
          TextField(
            controller: ctrl,
            keyboardType: const TextInputType.numberWithOptions(decimal: true),
            decoration: const InputDecoration(labelText: 'Cantidad'),
          ),
          const SizedBox(height: 8),
          DropdownButtonFormField<String>(
            initialValue: unidad,
            items: const [
              DropdownMenuItem(value: 'unidad', child: Text('unidad')),
              DropdownMenuItem(value: 'g', child: Text('gramos (g)')),
              DropdownMenuItem(value: 'ml', child: Text('ml')),
              DropdownMenuItem(value: 'oz', child: Text('onzas (oz)')),
              DropdownMenuItem(value: 'lb', child: Text('libras (lb)')),
            ],
            onChanged: (v) => unidad = v!,
          ),
        ]),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancelar')),
          FilledButton(
              onPressed: () => Navigator.pop(ctx, true), child: const Text('Agregar')),
        ],
      ),
    );
    if (ok == true) {
      final cant = double.tryParse(ctrl.text.trim()) ?? 0;
      await ref.read(gastronomiaServiceProvider).guardarRecetaItem(
            platoProductoId: widget.plato.id,
            insumoProductoId: selId,
            cantidad: cant,
            unidad: unidad,
          );
      ref.invalidate(recetaPlatoProvider(widget.plato.id));
    }
  }

  Future<void> _editar(
      RecetaIngredienteData it, ProductoData? insumo, List<ProductoData> insumos) async {
    final ctrl = TextEditingController(text: it.cantidad.toStringAsFixed(2));
    String unidad = it.unidad.isEmpty ? 'unidad' : it.unidad;
    final ok = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Text(insumo?.nombre ?? 'Insumo #${it.insumoProductoId}'),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          TextField(
            controller: ctrl,
            keyboardType: const TextInputType.numberWithOptions(decimal: true),
            decoration: const InputDecoration(labelText: 'Cantidad'),
          ),
          const SizedBox(height: 8),
          DropdownButtonFormField<String>(
            initialValue: unidad,
            items: const [
              DropdownMenuItem(value: 'unidad', child: Text('unidad')),
              DropdownMenuItem(value: 'g', child: Text('g')),
              DropdownMenuItem(value: 'ml', child: Text('ml')),
              DropdownMenuItem(value: 'oz', child: Text('oz')),
              DropdownMenuItem(value: 'lb', child: Text('lb')),
            ],
            onChanged: (v) => unidad = v!,
          ),
        ]),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancelar')),
          FilledButton(onPressed: () => Navigator.pop(ctx, true), child: const Text('Guardar')),
        ],
      ),
    );
    if (ok == true) {
      await ref.read(gastronomiaServiceProvider).guardarRecetaItem(
            id: it.id,
            platoProductoId: widget.plato.id,
            insumoProductoId: it.insumoProductoId,
            cantidad: double.tryParse(ctrl.text.trim()) ?? it.cantidad,
            unidad: unidad,
          );
      ref.invalidate(recetaPlatoProvider(widget.plato.id));
    }
  }
}
